 488:Core/Src/main.c **** 
 489:Core/Src/main.c **** #define ADC_VREF              3.3f
 490:Core/Src/main.c **** #define ADC_FULL_SCALE_CODES  2048.0f  // ADC1 is differential; signed code -2048..2047 spans -VREF
 491:Core/Src/main.c **** #define V_PEAK_NOM            200.0f
 492:Core/Src/main.c **** 
 493:Core/Src/main.c **** /**
 494:Core/Src/main.c ****  * Sensor transfer function (measured/derived from the actual circuit):
 495:Core/Src/main.c ****  *   Vout_p = Vin * (250/22000) *  0.43 + 1.65V
 496:Core/Src/main.c ****  *   Vout_n = Vin * (250/22000) * -0.43 + 1.65V
 497:Core/Src/main.c ****  * Both differential pins are biased at 1.65V (VDDA/2) with the signal
 498:Core/Src/main.c ****  * riding symmetrically in opposite directions, so the differential the ADC
 499:Core/Src/main.c ****  * actually measures is:
 500:Core/Src/main.c ****  *   Vinp - Vinn = Vout_p - Vout_n = SENSOR_GAIN * Vin
 501:Core/Src/main.c ****  * where SENSOR_GAIN = 2 * (250/22000) * 0.43. The 1.65V bias on each pin
 502:Core/Src/main.c ****  * cancels out in the subtraction -- no bias removal needed in software.
 503:Core/Src/main.c ****  */
 504:Core/Src/main.c **** #define SENSOR_GAIN (2.0f * (250.0f / 44000.0f) * 0.4779f)
 505:Core/Src/main.c **** #define DC_CAL 21.5f
 506:Core/Src/main.c **** #define GAIN_CAL 172.0f/159.0f
 507:Core/Src/main.c **** 
 508:Core/Src/main.c **** /**
 509:Core/Src/main.c ****  * ADC1 in differential mode reports Vinp-Vinn as a 12-bit *straight offset
 510:Core/Src/main.c ****  * binary* code (0..4095, unsigned) -- NOT two's complement. Code 2048
 511:Core/Src/main.c ****  * (0x800) means Vinp-Vinn = 0V; 0 means -VREF; 4095 means ~+VREF. Center
 512:Core/Src/main.c ****  * it on zero by subtracting the half-scale offset.
ARM GAS  /tmp/ccPxQPiv.s 			page 12


 513:Core/Src/main.c ****  */
 514:Core/Src/main.c **** static inline int16_t DifferentialCode(uint16_t raw12)
 515:Core/Src/main.c **** {
 516:Core/Src/main.c ****     return (int16_t)raw12 - (int16_t)ADC_FULL_SCALE_CODES;
 517:Core/Src/main.c **** }
 518:Core/Src/main.c **** 
 519:Core/Src/main.c **** static inline float adcToVoltsActual(int16_t adc_signed){
 520:Core/Src/main.c ****     float v_adc = (float)adc_signed * (ADC_VREF / ADC_FULL_SCALE_CODES); // differential volts at t
 521:Core/Src/main.c ****     return (v_adc / SENSOR_GAIN)*GAIN_CAL + DC_CAL;                                          // inv
 522:Core/Src/main.c **** }
 523:Core/Src/main.c **** 
 524:Core/Src/main.c **** static inline float normaliseVoltage(int16_t adc_signed){
 525:Core/Src/main.c ****     return adcToVoltsActual(adc_signed) / V_PEAK_NOM;       // normalize to ±1.0 like r_t
 526:Core/Src/main.c **** }
 527:Core/Src/main.c **** 
 528:Core/Src/main.c **** /**
 529:Core/Src/main.c ****  * @param adc_signed ADC1 differential reading, zero-centered (see DifferentialCode)
 530:Core/Src/main.c ****  */
 531:Core/Src/main.c **** static inline float Execute_HCA_Control(int16_t adc_signed, uint8_t update)
 532:Core/Src/main.c **** {
 533:Core/Src/main.c ****     static uint32_t step_fundamental = (uint32_t)((50.0f / (2.0f*SWITCH_RATE)) * 4294967296.0f);
 534:Core/Src/main.c ****     static uint32_t angle_fundamental = 0;
 535:Core/Src/main.c **** 
 536:Core/Src/main.c ****     uint32_t theta = angle_fundamental;
 537:Core/Src/main.c ****     float r_t = HCA_fastSin(theta)*0.8f;
 538:Core/Src/main.c **** 
 539:Core/Src/main.c ****     float error = r_t - (float)normaliseVoltage(adc_signed);
 540:Core/Src/main.c ****     float hca_out = HCA_Process(&hca, error);
 541:Core/Src/main.c **** 
 542:Core/Src/main.c ****     angle_fundamental += step_fundamental;
 543:Core/Src/main.c **** 
 544:Core/Src/main.c ****     if ((update & 0x1) == 0) {
 545:Core/Src/main.c ****       USPWM(htim8.Instance, hca_out, ARR_VAL, MODULATION_INDEX);  // modulation_index=1.0, already 
 546:Core/Src/main.c ****     }
 547:Core/Src/main.c **** 
 548:Core/Src/main.c ****     return error;
 549:Core/Src/main.c **** }
