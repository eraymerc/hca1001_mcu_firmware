  11:Core/Src/unipolar_spwm_controller.c **** /**
  12:Core/Src/unipolar_spwm_controller.c ****  * @brief Unipolar SPWM Duty Cycle Guncelleme Fonksiyonu
  13:Core/Src/unipolar_spwm_controller.c ****  * * Bu fonksiyon, disaridan gelen anlik sinyal genligine (amplitude) gore
  14:Core/Src/unipolar_spwm_controller.c ****  * ilgili Timer'in Channel 1 ve Channel 2 karsilastirma (CCR) degerlerini ayarlar.
  15:Core/Src/unipolar_spwm_controller.c ****  * Unipolar SPWM teknigi geregi, CH2'ye CH1'in 180 derece faz farkli (tersi) degeri yuklenir.
  16:Core/Src/unipolar_spwm_controller.c ****  * * @param tim: Kullanilacak Timer'in adresi (Orn: TIM8)
  17:Core/Src/unipolar_spwm_controller.c ****  * @param instant_signal: -1.0 ile +1.0 arasinda normalize edilmis anlik sinyal degeri.
  18:Core/Src/unipolar_spwm_controller.c ****  * (Orn: sin(angle) * modulation_index)
  19:Core/Src/unipolar_spwm_controller.c ****  * @param arr_val: Timer'in Auto-Reload Register (Period) degeri (Orn: 1799)
  20:Core/Src/unipolar_spwm_controller.c ****  * * @return unsigned int: CH1 bacagina yuklenen CCR degeri (Debug veya izleme amaclidir)
  21:Core/Src/unipolar_spwm_controller.c ****  */
  22:Core/Src/unipolar_spwm_controller.c **** unsigned int USPWM(TIM_TypeDef *tim, float instant_signal, uint32_t arr_val, float modulation_index
