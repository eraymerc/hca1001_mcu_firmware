 859:Core/Src/main.c **** 
 860:Core/Src/main.c **** /** Runs in the ADC ISR, once per sample. Costs four multiply-accumulates while
 861:Core/Src/main.c ****  *  a calibration is in flight and a single compare otherwise. */
 862:Core/Src/main.c **** static inline void CalibrationSample(float raw_volts)
 863:Core/Src/main.c **** {
 864:Core/Src/main.c ****     if (cal_state == CAL_IDLE || cal_state == CAL_COMPLETE) {
 865:Core/Src/main.c ****         return;
 866:Core/Src/main.c ****     }
 867:Core/Src/main.c **** 
 868:Core/Src/main.c ****     if (cal_state == CAL_MEASURING) {
