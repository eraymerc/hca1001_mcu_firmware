 972:Core/Src/main.c **** /** Validate a fully received SET_COEFF payload and push it into the controller. */
 973:Core/Src/main.c **** static void ApplyCoeffCommand(void)
 974:Core/Src/main.c **** {
 975:Core/Src/main.c ****     if (CoeffChecksum(coeff_rx, COEFF_CMD_PAYLOAD_LEN - 1U)
 976:Core/Src/main.c ****             != coeff_rx[COEFF_CMD_PAYLOAD_LEN - 1U]) {
 977:Core/Src/main.c ****         return; // corrupted on the wire; the host re-sends after its ack times out
 978:Core/Src/main.c ****     }
 979:Core/Src/main.c **** 
 980:Core/Src/main.c ****     uint8_t   order = coeff_rx[0];
 981:Core/Src/main.c ****     Complex_t kp, ki;
