  36:Core/Src/main.c **** /* USER CODE BEGIN PD */
  37:Core/Src/main.c **** #define ARR_VAL 4249
  38:Core/Src/main.c **** #define SWITCH_RATE 20000.0f // Hz, TIM8 carrier frequency (170MHz / (2*(ARR_VAL+1)))
  39:Core/Src/main.c **** 
  40:Core/Src/main.c **** /** ADC ISR runs at 40kHz; only push every Nth sample -> 40kHz/8 = 5kHz stream rate.
  41:Core/Src/main.c ****  *  5kHz puts Nyquist at 2.5kHz, so the host FFT resolves harmonics up to H50 of a
  42:Core/Src/main.c ****  *  50Hz fundamental. Costs 19 bytes * 5000 Hz = 95,000 B/s on a link good for
  43:Core/Src/main.c ****  *  209,700 B/s (2,097,000 baud, 8N1), i.e. about 45% of the wire. */
  44:Core/Src/main.c **** #define ADC_STREAM_DECIMATION 8U
  45:Core/Src/main.c **** 
  46:Core/Src/main.c **** /** Streaming frame ring buffer depth (must be a power of two) */
  47:Core/Src/main.c **** /* Each frame now carries STREAM_BATCH_SAMPLES samples, so 64 frames is 512
  48:Core/Src/main.c ****  * samples -- ~102ms of slack at the 5kHz stream rate, more than the 256
  49:Core/Src/main.c ****  * single-sample frames it replaces, for 4.8KB of RAM. */
  50:Core/Src/main.c **** #define STREAM_FIFO_LEN  64U
  51:Core/Src/main.c **** #define STREAM_FIFO_MASK (STREAM_FIFO_LEN - 1U)
  52:Core/Src/main.c **** 
  53:Core/Src/main.c **** /** LPUART1 RX ring filled by DMA, drained in the main loop (must be a power of two).
  54:Core/Src/main.c ****  *
  55:Core/Src/main.c ****  *  Polling HAL_UART_Receive() a byte at a time cannot keep up here: one byte is
  56:Core/Src/main.c ****  *  4.77us at 2,097,000 baud, while the main loop can sit inside a blocking
  57:Core/Src/main.c ****  *  HAL_UART_Transmit for ~90us per stream frame and is preempted by the 40kHz
  58:Core/Src/main.c ****  *  ADC ISR every 25us. A single-byte command survives that (it just waits in
  59:Core/Src/main.c ****  *  RDR), but every byte after the first in a multi-byte command is overrun and
  60:Core/Src/main.c ****  *  lost -- which is why SET_COEFF payloads never completed. DMA takes the CPU
  61:Core/Src/main.c ****  *  out of the capture path entirely, so main-loop latency no longer matters.
  62:Core/Src/main.c ****  *
  63:Core/Src/main.c ****  *  64 bytes is over three SET_COEFF commands' worth of slack. */
  64:Core/Src/main.c **** #define UART_RX_DMA_LEN  64U
  65:Core/Src/main.c **** #define UART_RX_DMA_MASK (UART_RX_DMA_LEN - 1U)
  66:Core/Src/main.c **** #define MODULATION_INDEX 0.85f
  67:Core/Src/main.c **** 
  68:Core/Src/main.c **** #define IS_OPENLOOP 0
  69:Core/Src/main.c **** 
  70:Core/Src/main.c **** /** Ceiling on reference_multiplier when running open loop. The reference is
  71:Core/Src/main.c ****  *  fed straight to the modulator there, so it may exceed MODULATION_INDEX --
  72:Core/Src/main.c ****  *  overmodulation is a legitimate open-loop test point. Closed loop the
  73:Core/Src/main.c ****  *  controller needs headroom above the reference to correct with, so the
  74:Core/Src/main.c ****  *  limit is MODULATION_INDEX itself; see SetReferenceMultiplier. */
  75:Core/Src/main.c **** #define REF_MULT_OPENLOOP_MAX 1.0f
  76:Core/Src/main.c **** /* USER CODE END PD */
  77:Core/Src/main.c **** 
  78:Core/Src/main.c **** /* Private macro -------------------------------------------------------------*/
