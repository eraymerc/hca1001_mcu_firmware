 251:Core/Src/hca_lib.c ****         HCA_Channel_t *ch = &hca->channels[i];
 252:Core/Src/hca_lib.c **** 
 253:Core/Src/hca_lib.c ****         // ----------------------------------------------------
 254:Core/Src/hca_lib.c ****         // DDS phase update
 255:Core/Src/hca_lib.c ****         // ----------------------------------------------------
 256:Core/Src/hca_lib.c ****         ch->current_angle += ch->angle_step;
 257:Core/Src/hca_lib.c **** 
 258:Core/Src/hca_lib.c ****         // Phase-compensated rotating phasor
 259:Core/Src/hca_lib.c ****         Complex_t rot_pos = {0.0f, 0.0f};
 260:Core/Src/hca_lib.c ****         HCA_getPhasor(
 261:Core/Src/hca_lib.c ****             ch->current_angle +
 262:Core/Src/hca_lib.c ****             ch->angle_step * HCA_DELAY_COMPENSATION_MULTIPLIER,
 263:Core/Src/hca_lib.c ****             &rot_pos
 264:Core/Src/hca_lib.c ****         );
 265:Core/Src/hca_lib.c **** 
 266:Core/Src/hca_lib.c ****         // ====================================================
 267:Core/Src/hca_lib.c ****         // DISPERSER
 268:Core/Src/hca_lib.c ****         // ====================================================
 269:Core/Src/hca_lib.c ****         // Input -> Step -> Modulation
 270:Core/Src/hca_lib.c **** 
 271:Core/Src/hca_lib.c ****         // 1. Modulation: x * e^{-jωt}
ARM GAS  /tmp/cceyVHsM.s 			page 16


 272:Core/Src/hca_lib.c ****         Complex_t modulated_val;
 273:Core/Src/hca_lib.c ****         modulated_val.real = harmonic_step * rot_pos.real;
 274:Core/Src/hca_lib.c ****         modulated_val.imag = harmonic_step * (-rot_pos.imag);
 275:Core/Src/hca_lib.c **** 
 276:Core/Src/hca_lib.c ****         ch->current_val = Complex_Add(ch->current_val, modulated_val);
 277:Core/Src/hca_lib.c **** 
 278:Core/Src/hca_lib.c ****         // ====================================================
 279:Core/Src/hca_lib.c ****         // COMPLEX PI CONTROLLER
 280:Core/Src/hca_lib.c ****         // ====================================================
 281:Core/Src/hca_lib.c ****         // error_dq -> PI -> output_dq
 282:Core/Src/hca_lib.c **** 
 283:Core/Src/hca_lib.c ****         Complex_t error_dq = ch->current_val;
 284:Core/Src/hca_lib.c **** 
 285:Core/Src/hca_lib.c ****         // Proportional term
 286:Core/Src/hca_lib.c ****         Complex_t prop_term = Complex_Mult(ch->Kp, error_dq);
 287:Core/Src/hca_lib.c **** 
 288:Core/Src/hca_lib.c ****         // Integral term
 289:Core/Src/hca_lib.c ****         Complex_t ki_term = Complex_Mult(ch->Ki, error_dq);
 290:Core/Src/hca_lib.c ****         Complex_t ki_step =
 291:Core/Src/hca_lib.c ****             Complex_Scale(ki_term, hca->sampling_time);
 292:Core/Src/hca_lib.c **** 
 293:Core/Src/hca_lib.c ****         ch->integrator_state =
 294:Core/Src/hca_lib.c ****             Complex_Add(ch->integrator_state, ki_step);
 295:Core/Src/hca_lib.c **** 
 296:Core/Src/hca_lib.c ****         // Anti-windup saturation
 297:Core/Src/hca_lib.c ****         float limit = hca->output_limit;
 298:Core/Src/hca_lib.c ****         if (ch->integrator_state.real > limit)
 299:Core/Src/hca_lib.c ****             ch->integrator_state.real = limit;
 300:Core/Src/hca_lib.c ****         if (ch->integrator_state.real < -limit)
 301:Core/Src/hca_lib.c ****             ch->integrator_state.real = -limit;
 302:Core/Src/hca_lib.c ****         if (ch->integrator_state.imag > limit)
 303:Core/Src/hca_lib.c ****             ch->integrator_state.imag = limit;
 304:Core/Src/hca_lib.c ****         if (ch->integrator_state.imag < -limit)
 305:Core/Src/hca_lib.c ****             ch->integrator_state.imag = -limit;
 306:Core/Src/hca_lib.c **** 
 307:Core/Src/hca_lib.c ****         Complex_t output_dq =
 308:Core/Src/hca_lib.c ****             Complex_Add(prop_term, ch->integrator_state);
 309:Core/Src/hca_lib.c **** 
 310:Core/Src/hca_lib.c ****         // ====================================================
 311:Core/Src/hca_lib.c ****         // ASSEMBLER
 312:Core/Src/hca_lib.c ****         // ====================================================
 313:Core/Src/hca_lib.c ****         // Inverse modulation and harmonic reconstruction
 314:Core/Src/hca_lib.c **** 
 315:Core/Src/hca_lib.c ****         // 1. Rotate back: output_dq * e^{+jωt}
 316:Core/Src/hca_lib.c ****         Complex_t rotated_val =
 317:Core/Src/hca_lib.c ****             Complex_Mult(output_dq, rot_pos);
 318:Core/Src/hca_lib.c **** 
 319:Core/Src/hca_lib.c ****         // 2. Take real part and scale
 320:Core/Src/hca_lib.c ****         // SPECIAL CASE FOR DC (Order 0):
 321:Core/Src/hca_lib.c ****         // For AC harmonics, the complex phasor representation splits amplitude into 
 322:Core/Src/hca_lib.c ****         // two counter-rotating vectors (Euler's formula), requiring a gain of 2.0 
 323:Core/Src/hca_lib.c ****         // to reconstruct the original amplitude.
 324:Core/Src/hca_lib.c ****         // For DC (Order 0), there is no splitting (cos(0)=1), so the gain must be 1.0.
 325:Core/Src/hca_lib.c ****         float current_gain = (ch->harmonic_order == 0) ? 1.0f : 2.0f;
