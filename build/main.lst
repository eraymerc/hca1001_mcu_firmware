 692:Core/Src/main.c **** static uint8_t StreamChecksum(const AdcStreamFrame_t *f)
 693:Core/Src/main.c **** {
 694:Core/Src/main.c ****     const uint8_t *p = (const uint8_t*)&f->seq;
 695:Core/Src/main.c ****     const uint16_t len = (uint16_t)(sizeof(AdcStreamFrame_t) - sizeof(f->sync0)
 696:Core/Src/main.c ****                                      - sizeof(f->sync1) - sizeof(f->checksum));
 697:Core/Src/main.c ****     uint8_t sum = 0;
 698:Core/Src/main.c ****     for (uint16_t i = 0; i < len; i++) {
 699:Core/Src/main.c ****         sum += p[i];
 700:Core/Src/main.c ****     }
 701:Core/Src/main.c ****     return sum;
 702:Core/Src/main.c **** }
