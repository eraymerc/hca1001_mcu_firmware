 106:Core/Src/main.c **** 
 107:Core/Src/main.c **** /* Single-producer (ADC ISR) / single-consumer (main loop) ring buffer of frames */
 108:Core/Src/main.c **** static AdcStreamFrame_t  stream_fifo[STREAM_FIFO_LEN];
 109:Core/Src/main.c **** static volatile uint16_t stream_fifo_head = 0;
 110:Core/Src/main.c **** static volatile uint16_t stream_fifo_tail = 0;
 111:Core/Src/main.c **** static volatile uint32_t stream_seq = 0;
 112:Core/Src/main.c **** /* Set while a stream frame is in flight on DMA1_Channel3; cleared by the
 113:Core/Src/main.c ****  * transfer-complete callback, which is also where the FIFO tail advances. The
 114:Core/Src/main.c ****  * slot must stay untouched until then, since the DMA is reading straight out
 115:Core/Src/main.c ****  * of it. */
 116:Core/Src/main.c **** static volatile uint8_t  stream_tx_busy = 0;
