 689:Core/Src/main.c **** /** Largest reference multiplier this build accepts, see CONTROL_TYPE above. */
 690:Core/Src/main.c **** static inline float ReferenceMultiplierLimit(void)
 691:Core/Src/main.c **** {
 692:Core/Src/main.c **** #if CONTROL_TYPE == CONTROL_TYPE_OPENLOOP
 693:Core/Src/main.c ****     return REF_MULT_OPENLOOP_MAX;
 694:Core/Src/main.c **** #else
 695:Core/Src/main.c ****     return MODULATION_INDEX;
 696:Core/Src/main.c **** #endif
