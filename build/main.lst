 127:Core/Src/main.c **** 
 128:Core/Src/main.c **** /* Single-producer (ADC ISR) / single-consumer (main loop) ring buffer of frames */
 129:Core/Src/main.c **** static AdcStreamFrame_t  stream_fifo[STREAM_FIFO_LEN];
 130:Core/Src/main.c **** static volatile uint16_t stream_fifo_head = 0;
 131:Core/Src/main.c **** static volatile uint16_t stream_fifo_tail = 0;
 132:Core/Src/main.c **** static volatile uint32_t stream_seq = 0;
 133:Core/Src/main.c **** /* Set while a stream frame is in flight on DMA1_Channel3; cleared by the
 134:Core/Src/main.c ****  * transfer-complete callback, which is also where the FIFO tail advances. The
 135:Core/Src/main.c ****  * slot must stay untouched until then, since the DMA is reading straight out
 136:Core/Src/main.c ****  * of it. */
 137:Core/Src/main.c **** static volatile uint8_t  stream_tx_busy = 0;
