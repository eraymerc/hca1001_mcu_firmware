1055:Core/Src/main.c ****         }
1056:Core/Src/main.c ****     }
1057:Core/Src/main.c **** 
1058:Core/Src/main.c ****     switch (cmd)
1059:Core/Src/main.c ****     {
1060:Core/Src/main.c ****         case STREAM_CMD_GET_COEFF:
1061:Core/Src/main.c **** #if CONTROL_TYPE == CONTROL_TYPE_HCA
