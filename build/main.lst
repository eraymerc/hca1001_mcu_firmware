 886:Core/Src/main.c **** static uint8_t StreamChecksum(const AdcStreamFrame_t *f)
 887:Core/Src/main.c **** {
 888:Core/Src/main.c ****     const uint8_t *p = (const uint8_t*)&f->seq;
 889:Core/Src/main.c ****     const uint16_t len = (uint16_t)(sizeof(AdcStreamFrame_t) - sizeof(f->sync0)
 890:Core/Src/main.c ****                                      - sizeof(f->sync1) - sizeof(f->checksum));
 891:Core/Src/main.c ****     uint8_t sum = 0;
 892:Core/Src/main.c ****     for (uint16_t i = 0; i < len; i++) {
 893:Core/Src/main.c ****         sum += p[i];
 894:Core/Src/main.c ****     }
 895:Core/Src/main.c ****     return sum;
