  92:Core/Src/main.c **** /* LPUART1 receive path: DMA writes here continuously, the main loop follows it.
  93:Core/Src/main.c ****  * hdma_lpuart1_rx itself is CubeMX-generated (LPUART1 -> DMA Settings in the
  94:Core/Src/main.c ****  * .ioc: DMA1 Channel2, circular, byte-wide). */
  95:Core/Src/main.c **** static uint8_t    uart_rx_dma[UART_RX_DMA_LEN];
