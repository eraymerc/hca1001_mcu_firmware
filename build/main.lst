 658:Core/Src/main.c ****  */
 659:Core/Src/main.c **** #define SENSOR_GAIN (2.0f * (250.0f / 44000.0f) * 0.4779f)
 660:Core/Src/main.c **** #define DC_CAL 2.6f
 661:Core/Src/main.c **** #define GAIN_CAL 1.0f
 662:Core/Src/main.c **** 
 663:Core/Src/main.c **** /**
 664:Core/Src/main.c ****  * ADC1 in differential mode reports Vinp-Vinn as a 12-bit *straight offset
 665:Core/Src/main.c ****  * binary* code (0..4095, unsigned) -- NOT two's complement. Code 2048
 666:Core/Src/main.c ****  * (0x800) means Vinp-Vinn = 0V; 0 means -VREF; 4095 means ~+VREF. Center
 667:Core/Src/main.c ****  * it on zero by subtracting the half-scale offset.
 668:Core/Src/main.c ****  */
 669:Core/Src/main.c **** static inline int16_t DifferentialCode(uint16_t raw12)
 670:Core/Src/main.c **** {
 671:Core/Src/main.c ****     return (int16_t)raw12 - (int16_t)ADC_FULL_SCALE_CODES;
 672:Core/Src/main.c **** }
