 952:Core/Src/main.c ****         }
 953:Core/Src/main.c ****     }
 954:Core/Src/main.c **** 
 955:Core/Src/main.c ****     switch (cmd)
 956:Core/Src/main.c ****     {
 957:Core/Src/main.c ****         case STREAM_CMD_GET_COEFF:
 958:Core/Src/main.c ****             SendAllCoeffFrames();
 959:Core/Src/main.c ****             break;
 960:Core/Src/main.c **** 
 961:Core/Src/main.c ****         case STREAM_CMD_RESET_INT:
 962:Core/Src/main.c ****             /* Zeroes each channel's PI integrator and disperser accumulator and
 963:Core/Src/main.c ****              * clears the shared delay line. Runs from the main loop while the
 964:Core/Src/main.c ****              * ISR keeps calling HCA_Process, so the controller sees the state
 965:Core/Src/main.c ****              * vanish mid-sample -- that is the point of the command, but it does
 966:Core/Src/main.c ****              * put a transient on the output. The ~16KB memset costs roughly one
 967:Core/Src/main.c ****              * 40kHz ISR period.
 968:Core/Src/main.c ****              *
 969:Core/Src/main.c ****              * Gains are untouched, so echoing them back doubles as the ack. */
 970:Core/Src/main.c ****             HCA_reset_accumulators((HCA_Handle_t*)&hca);
