 557:Core/Src/main.c ****     f->sync0        = STREAM_SYNC0;
 558:Core/Src/main.c ****     f->sync1        = STREAM_SYNC1;
 559:Core/Src/main.c ****     f->seq          = stream_seq++;
 560:Core/Src/main.c ****     f->timestamp_ms = HAL_GetTick();
 561:Core/Src/main.c ****     f->voltage      = voltage;
 562:Core/Src/main.c ****     f->error        = error;
 563:Core/Src/main.c ****     f->checksum     = StreamChecksum(f);
 564:Core/Src/main.c **** 
 565:Core/Src/main.c ****     stream_fifo_head = next_head;
 566:Core/Src/main.c **** }
