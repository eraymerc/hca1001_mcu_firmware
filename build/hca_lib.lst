 152:Core/Src/hca_lib.c **** // ============================================================
 153:Core/Src/hca_lib.c **** // Kahan (compensated) summation for the disperser sum
 154:Core/Src/hca_lib.c **** // ============================================================
 155:Core/Src/hca_lib.c **** 
 156:Core/Src/hca_lib.c **** /*
 157:Core/Src/hca_lib.c ****  * Kahan summation only works if the compiler evaluates (t - s) - y literally.
 158:Core/Src/hca_lib.c ****  * -ffast-math / -Ofast let it "simplify" that to 0, which silently turns this
 159:Core/Src/hca_lib.c ****  * back into a plain float sum, so refuse to build that way.
 160:Core/Src/hca_lib.c ****  * FMA contraction (-ffp-contract=fast) is harmless here: it can only fuse the
 161:Core/Src/hca_lib.c ****  * product feeding x into y = x - comp, and y is then used consistently.
 162:Core/Src/hca_lib.c ****  */
 163:Core/Src/hca_lib.c **** #ifdef __FAST_MATH__
 164:Core/Src/hca_lib.c **** #error "hca_lib.c: Kahan summation is broken by -ffast-math / -Ofast"
 165:Core/Src/hca_lib.c **** #endif
 166:Core/Src/hca_lib.c **** 
 167:Core/Src/hca_lib.c **** /**
 168:Core/Src/hca_lib.c ****  * @brief *sum += x, carrying the rounding loss in *comp to the next call.
 169:Core/Src/hca_lib.c ****  *
 170:Core/Src/hca_lib.c ****  * The error of the running sum stays at a few ulp no matter how many terms
 171:Core/Src/hca_lib.c ****  * are added, instead of growing with the number of samples.
 172:Core/Src/hca_lib.c ****  */
 173:Core/Src/hca_lib.c **** static inline void Kahan_Add(float *sum, float *comp, float x) {
 174:Core/Src/hca_lib.c ****     float y = x - *comp;        // new term, plus what the last addition lost
 175:Core/Src/hca_lib.c ****     float t = *sum + y;         // rounded sum
 176:Core/Src/hca_lib.c ****     *comp = (t - *sum) - y;     // (what was really added) - (what we wanted)
 177:Core/Src/hca_lib.c ****     *sum = t;
 178:Core/Src/hca_lib.c **** }
 179:Core/Src/hca_lib.c **** 
 180:Core/Src/hca_lib.c **** static inline void Disperser_Reset(HCA_Channel_t *ch) {
 181:Core/Src/hca_lib.c ****     ch->current_val.real = 0.0f;
 182:Core/Src/hca_lib.c ****     ch->current_val.imag = 0.0f;
 183:Core/Src/hca_lib.c ****     ch->current_val_comp.real = 0.0f;
 184:Core/Src/hca_lib.c ****     ch->current_val_comp.imag = 0.0f;
 185:Core/Src/hca_lib.c **** }
 186:Core/Src/hca_lib.c **** 
