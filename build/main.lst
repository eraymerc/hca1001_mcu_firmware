 749:Core/Src/main.c **** // Manages the HCA loop and the telemetry stream, both at the 40kHz sample rate
 750:Core/Src/main.c **** volatile uint32_t tick_counter = 0;
 751:Core/Src/main.c **** void HAL_ADC_ConvCpltCallback(ADC_HandleTypeDef *hadc)
 752:Core/Src/main.c **** {
 753:Core/Src/main.c ****     if (hadc->Instance == ADC1)
 754:Core/Src/main.c ****     {
 755:Core/Src/main.c ****         int16_t v_adc_signed = DifferentialCode(adc1_raw); // voltage, differential
 756:Core/Src/main.c **** 
 757:Core/Src/main.c ****         tick_counter++;
 758:Core/Src/main.c **** 
 759:Core/Src/main.c ****         float reference;
 760:Core/Src/main.c ****         float error = Execute_HCA_Control(v_adc_signed, tick_counter, &reference);
 761:Core/Src/main.c **** 
 762:Core/Src/main.c ****         if (streaming_enabled)
 763:Core/Src/main.c ****         {
 764:Core/Src/main.c ****             float voltage_v = adcToVoltsActual(v_adc_signed);
 765:Core/Src/main.c ****             PushStreamFrame(voltage_v, reference, error);
 766:Core/Src/main.c ****         }
 767:Core/Src/main.c ****     }
 768:Core/Src/main.c **** }
