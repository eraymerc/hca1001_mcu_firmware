 562:Core/Src/main.c **** // Manages the HCA loop 40kHz sample rate and 1kHz telemetry rate
 563:Core/Src/main.c **** volatile uint32_t tick_counter = 0;
 564:Core/Src/main.c **** void HAL_ADC_ConvCpltCallback(ADC_HandleTypeDef *hadc)
 565:Core/Src/main.c **** {
 566:Core/Src/main.c ****     if (hadc->Instance == ADC1)
 567:Core/Src/main.c ****     {
 568:Core/Src/main.c ****         int16_t v_adc_signed = DifferentialCode(adc1_raw); // voltage, differential
 569:Core/Src/main.c **** 
 570:Core/Src/main.c ****         tick_counter++;
 571:Core/Src/main.c **** 
 572:Core/Src/main.c ****         float error = Execute_HCA_Control(v_adc_signed, tick_counter);
 573:Core/Src/main.c **** 
 574:Core/Src/main.c ****         if (streaming_enabled && ((tick_counter % ADC_STREAM_DECIMATION) == 0U))
 575:Core/Src/main.c ****         {
 576:Core/Src/main.c ****             float voltage_v = adcToVoltsActual(v_adc_signed);
 577:Core/Src/main.c ****             PushStreamFrame(voltage_v, error);
 578:Core/Src/main.c ****         }
 579:Core/Src/main.c ****     }
 580:Core/Src/main.c **** }
