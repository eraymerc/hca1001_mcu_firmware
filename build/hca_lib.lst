  96:Core/Src/hca_lib.c **** // ============================================================
  97:Core/Src/hca_lib.c **** // Fixed-point integrator helpers (format: see HCA_INTEG_FRAC_BITS)
  98:Core/Src/hca_lib.c **** // ============================================================
  99:Core/Src/hca_lib.c **** 
 100:Core/Src/hca_lib.c **** _Static_assert(31 + HCA_INTEG_OUT_SHIFT - HCA_INTEG_FRAC_BITS >= 1,
 101:Core/Src/hca_lib.c ****                "integrator read-back word cannot hold +-1.0");
 102:Core/Src/hca_lib.c **** 
 103:Core/Src/hca_lib.c **** /** 1.0 in integrator units; a power of two, so exact as a float */
 104:Core/Src/hca_lib.c **** #define HCA_INTEG_ONE        ((float)(1ULL << HCA_INTEG_FRAC_BITS))
 105:Core/Src/hca_lib.c **** 
 106:Core/Src/hca_lib.c **** /** Weight of one LSB of the int32 read-back word */
 107:Core/Src/hca_lib.c **** #define HCA_INTEG_OUT_LSB    (1.0f / (float)(1UL << (HCA_INTEG_FRAC_BITS - HCA_INTEG_OUT_SHIFT)))
 108:Core/Src/hca_lib.c **** 
 109:Core/Src/hca_lib.c **** /** Largest |output_limit| whose fixed-point value still fits the read-back word */
 110:Core/Src/hca_lib.c **** #define HCA_INTEG_LIMIT_MAX  ((float)(1UL << (31 + HCA_INTEG_OUT_SHIFT - HCA_INTEG_FRAC_BITS)) - 1.
 111:Core/Src/hca_lib.c **** 
 112:Core/Src/hca_lib.c **** /** Largest float below 2^31, the bound for a defined float -> int32 cast */
 113:Core/Src/hca_lib.c **** #define HCA_INT32_MAX_F      2147483520.0f
 114:Core/Src/hca_lib.c **** 
 115:Core/Src/hca_lib.c **** /**
 116:Core/Src/hca_lib.c ****  * @brief Float increment (already in integrator units) -> int32.
 117:Core/Src/hca_lib.c ****  *
 118:Core/Src/hca_lib.c ****  * Saturates first, since an out-of-range float -> int cast is undefined in C.
 119:Core/Src/hca_lib.c ****  * The cast truncates toward zero; the resulting bias is at most one LSB
 120:Core/Src/hca_lib.c ****  * (9e-13) per sample, i.e. ~4e-8 per second at 40kHz -- negligible.
 121:Core/Src/hca_lib.c ****  */
 122:Core/Src/hca_lib.c **** static inline int32_t Integ_Increment(float x) {
 123:Core/Src/hca_lib.c ****     if (x >  HCA_INT32_MAX_F) return  INT32_MAX;
 124:Core/Src/hca_lib.c ****     if (x < -HCA_INT32_MAX_F) return -INT32_MAX;
 125:Core/Src/hca_lib.c ****     return (int32_t)x;
 126:Core/Src/hca_lib.c **** }
 127:Core/Src/hca_lib.c **** 
 128:Core/Src/hca_lib.c **** static inline int64_t Integ_Clamp(int64_t v, int64_t limit) {
 129:Core/Src/hca_lib.c ****     if (v >  limit) return  limit;
 130:Core/Src/hca_lib.c ****     if (v < -limit) return -limit;
 131:Core/Src/hca_lib.c ****     return v;
 132:Core/Src/hca_lib.c **** }
 133:Core/Src/hca_lib.c **** 
 134:Core/Src/hca_lib.c **** /**
 135:Core/Src/hca_lib.c ****  * @brief Fixed-point integrator -> float.
 136:Core/Src/hca_lib.c ****  *
 137:Core/Src/hca_lib.c ****  * Goes through an int32 so the conversion is a single VCVT instead of a
 138:Core/Src/hca_lib.c ****  * soft-float int64 library call. |v| <= integ_limit_fx < 2^47, so the shifted
 139:Core/Src/hca_lib.c ****  * value always fits. Right-shifting a negative int64 is arithmetic on GCC.
 140:Core/Src/hca_lib.c ****  */
 141:Core/Src/hca_lib.c **** static inline float Integ_ToFloat(int64_t v) {
 142:Core/Src/hca_lib.c ****     return (float)(int32_t)(v >> HCA_INTEG_OUT_SHIFT) * HCA_INTEG_OUT_LSB;
 143:Core/Src/hca_lib.c **** }
