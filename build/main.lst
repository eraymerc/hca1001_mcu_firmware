 295:Core/Src/main.c ****     /* Everything DMA has written since the last pass. CNDTR counts down, so
 296:Core/Src/main.c ****      * the write position is the buffer length minus what is left to fill. */
 297:Core/Src/main.c ****     uint16_t rx_head = (uint16_t)(UART_RX_DMA_LEN
 298:Core/Src/main.c ****                                   - __HAL_DMA_GET_COUNTER(&hdma_lpuart1_rx));
 299:Core/Src/main.c ****     while (uart_rx_tail != rx_head)
 300:Core/Src/main.c ****     {
 301:Core/Src/main.c ****       HandleStreamCommand(uart_rx_dma[uart_rx_tail]);
 302:Core/Src/main.c ****       uart_rx_tail = (uint16_t)((uart_rx_tail + 1U) & UART_RX_DMA_MASK);
 303:Core/Src/main.c ****     }
 304:Core/Src/main.c **** 
 305:Core/Src/main.c ****     /* DMA transmit is wired up (HAL_UART_TxCpltCallback below) but stays off
 306:Core/Src/main.c ****      * until the LPUART1 global interrupt is enabled in CubeMX: HAL signals a
 307:Core/Src/main.c ****      * DMA transmit's completion from the UART's TC interrupt, not the DMA's,
 308:Core/Src/main.c ****      * so without that NVIC entry gState never returns to READY and the stream
 309:Core/Src/main.c ****      * stops dead after one frame. Swap these two blocks once it is enabled.
