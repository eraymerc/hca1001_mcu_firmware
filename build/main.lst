 856:Core/Src/main.c ****      * faults on an unaligned float load. */
 857:Core/Src/main.c ****     memcpy(&kp.real, &coeff_rx[1],  sizeof(float));
 858:Core/Src/main.c ****     memcpy(&kp.imag, &coeff_rx[5],  sizeof(float));
 859:Core/Src/main.c ****     memcpy(&ki.real, &coeff_rx[9],  sizeof(float));
 860:Core/Src/main.c ****     memcpy(&ki.imag, &coeff_rx[13], sizeof(float));
 861:Core/Src/main.c **** 
 862:Core/Src/main.c ****     /* Gains only -- this never creates a channel. The set of active channels is
 863:Core/Src/main.c ****      * fixed at boot by the HCA_Add_Channel calls in main(), so the ISR's
 864:Core/Src/main.c ****      * per-sample workload cannot change underneath it while running.
 865:Core/Src/main.c ****      *
 866:Core/Src/main.c ****      * Safe from the main loop; see the thread-safety note on HCA_UpdateChannel.
 867:Core/Src/main.c ****      * An order with no channel is ignored there, and the absent echo below is
 868:Core/Src/main.c ****      * what tells the host the write did not land. */
 869:Core/Src/main.c ****     HCA_Handle_t *h = (HCA_Handle_t*)&hca;
 870:Core/Src/main.c ****     HCA_UpdateChannel(h, order, kp, ki);
 871:Core/Src/main.c **** 
 872:Core/Src/main.c ****     for (uint8_t i = 0; i < h->active_channel_count; i++) {
 873:Core/Src/main.c ****         if (h->channels[i].harmonic_order == order) {
 874:Core/Src/main.c ****             SendCoeffFrame(i, h->active_channel_count, &h->channels[i]);
 875:Core/Src/main.c ****             return;
