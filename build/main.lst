 832:Core/Src/main.c ****     uint32_t seq = stream_seq++;
 833:Core/Src/main.c **** 
 834:Core/Src/main.c ****     uint16_t next_head = (uint16_t)((stream_fifo_head + 1U) & STREAM_FIFO_MASK);
