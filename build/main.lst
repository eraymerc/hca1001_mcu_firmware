 814:Core/Src/main.c **** /** Command byte polled from LPUART1 in the main loop (see HAL_UART_Receive call in USER CODE 3). *
 815:Core/Src/main.c **** static void HandleStreamCommand(uint8_t cmd)
 816:Core/Src/main.c **** {
 817:Core/Src/main.c ****     if (coeff_rx_active)
 818:Core/Src/main.c ****     {
 819:Core/Src/main.c ****         if ((HAL_GetTick() - coeff_rx_started_ms) > COEFF_CMD_TIMEOUT_MS) {
 820:Core/Src/main.c ****             coeff_rx_active = 0;  // stale payload; fall through and read this byte as a command
 821:Core/Src/main.c ****         } else {
 822:Core/Src/main.c ****             coeff_rx[coeff_rx_len++] = cmd;
 823:Core/Src/main.c ****             if (coeff_rx_len >= COEFF_CMD_PAYLOAD_LEN) {
 824:Core/Src/main.c ****                 coeff_rx_active = 0;
 825:Core/Src/main.c ****                 coeff_rx_len = 0;
 826:Core/Src/main.c ****                 ApplyCoeffCommand();
 827:Core/Src/main.c ****             }
 828:Core/Src/main.c ****             return;
 829:Core/Src/main.c ****         }
 830:Core/Src/main.c ****     }
 831:Core/Src/main.c **** 
 832:Core/Src/main.c ****     switch (cmd)
 833:Core/Src/main.c ****     {
 834:Core/Src/main.c ****         case STREAM_CMD_GET_COEFF:
 835:Core/Src/main.c ****             SendAllCoeffFrames();
 836:Core/Src/main.c ****             break;
 837:Core/Src/main.c **** 
 838:Core/Src/main.c ****         case STREAM_CMD_RESET_INT:
 839:Core/Src/main.c ****             /* Zeroes each channel's PI integrator and disperser accumulator and
 840:Core/Src/main.c ****              * clears the shared delay line. Runs from the main loop while the
 841:Core/Src/main.c ****              * ISR keeps calling HCA_Process, so the controller sees the state
 842:Core/Src/main.c ****              * vanish mid-sample -- that is the point of the command, but it does
 843:Core/Src/main.c ****              * put a transient on the output. The ~16KB memset costs roughly one
 844:Core/Src/main.c ****              * 40kHz ISR period.
 845:Core/Src/main.c ****              *
 846:Core/Src/main.c ****              * Gains are untouched, so echoing them back doubles as the ack. */
 847:Core/Src/main.c ****             HCA_reset_accumulators((HCA_Handle_t*)&hca);
 848:Core/Src/main.c ****             SendAllCoeffFrames();
ARM GAS  /tmp/cc3FokBo.s 			page 21


 849:Core/Src/main.c ****             break;
 850:Core/Src/main.c **** 
 851:Core/Src/main.c ****         case STREAM_CMD_SET_COEFF:
 852:Core/Src/main.c ****             coeff_rx_active = 1;
 853:Core/Src/main.c ****             coeff_rx_len = 0;
 854:Core/Src/main.c ****             coeff_rx_started_ms = HAL_GetTick();
 855:Core/Src/main.c ****             break;
 856:Core/Src/main.c **** 
 857:Core/Src/main.c ****         case STREAM_CMD_START:
 858:Core/Src/main.c ****             streaming_enabled = 1;
 859:Core/Src/main.c ****             break;
 860:Core/Src/main.c **** 
 861:Core/Src/main.c ****         case STREAM_CMD_STOP:
 862:Core/Src/main.c ****             streaming_enabled = 0;
 863:Core/Src/main.c ****             break;
 864:Core/Src/main.c **** 
 865:Core/Src/main.c ****         case STREAM_CMD_PING:
 866:Core/Src/main.c ****             StreamTxWaitIdle();
 867:Core/Src/main.c ****             HAL_UART_Transmit(&hlpuart1, (uint8_t*)STREAM_PING_REPLY,
 868:Core/Src/main.c ****                                (uint16_t)(sizeof(STREAM_PING_REPLY) - 1U), 10);
 869:Core/Src/main.c ****             break;
 870:Core/Src/main.c **** 
