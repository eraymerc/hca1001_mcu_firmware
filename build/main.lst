 473:Core/Src/main.c **** 
 474:Core/Src/main.c **** #define ADC_VREF              3.3f
 475:Core/Src/main.c **** #define ADC_FULL_SCALE_CODES  2048.0f  // ADC1 is differential; signed code -2048..2047 spans -VREF
 476:Core/Src/main.c **** #define V_PEAK_NOM            250.0f
 477:Core/Src/main.c **** 
 478:Core/Src/main.c **** /**
 479:Core/Src/main.c ****  * Sensor transfer function (measured/derived from the actual circuit):
 480:Core/Src/main.c ****  *   Vout_p = Vin * (250/22000) *  0.43 + 1.65V
 481:Core/Src/main.c ****  *   Vout_n = Vin * (250/22000) * -0.43 + 1.65V
 482:Core/Src/main.c ****  * Both differential pins are biased at 1.65V (VDDA/2) with the signal
 483:Core/Src/main.c ****  * riding symmetrically in opposite directions, so the differential the ADC
 484:Core/Src/main.c ****  * actually measures is:
 485:Core/Src/main.c ****  *   Vinp - Vinn = Vout_p - Vout_n = SENSOR_GAIN * Vin
 486:Core/Src/main.c ****  * where SENSOR_GAIN = 2 * (250/22000) * 0.43. The 1.65V bias on each pin
 487:Core/Src/main.c ****  * cancels out in the subtraction -- no bias removal needed in software.
 488:Core/Src/main.c ****  */
 489:Core/Src/main.c **** #define SENSOR_GAIN (2.0f * (250.0f / 44000.0f) * 0.4779f)
 490:Core/Src/main.c **** #define DC_CAL 21.5f
 491:Core/Src/main.c **** #define GAIN_CAL 172.0f/159.0f
 492:Core/Src/main.c **** 
 493:Core/Src/main.c **** /**
 494:Core/Src/main.c ****  * ADC1 in differential mode reports Vinp-Vinn as a 12-bit *straight offset
 495:Core/Src/main.c ****  * binary* code (0..4095, unsigned) -- NOT two's complement. Code 2048
 496:Core/Src/main.c ****  * (0x800) means Vinp-Vinn = 0V; 0 means -VREF; 4095 means ~+VREF. Center
 497:Core/Src/main.c ****  * it on zero by subtracting the half-scale offset.
 498:Core/Src/main.c ****  */
 499:Core/Src/main.c **** static inline int16_t DifferentialCode(uint16_t raw12)
 500:Core/Src/main.c **** {
 501:Core/Src/main.c ****     return (int16_t)raw12 - (int16_t)ADC_FULL_SCALE_CODES;
 502:Core/Src/main.c **** }
 503:Core/Src/main.c **** 
 504:Core/Src/main.c **** static inline float adcToVoltsActual(int16_t adc_signed){
 505:Core/Src/main.c ****     float v_adc = (float)adc_signed * (ADC_VREF / ADC_FULL_SCALE_CODES); // differential volts at t
 506:Core/Src/main.c ****     return (v_adc / SENSOR_GAIN)*GAIN_CAL + DC_CAL;                                          // inv
 507:Core/Src/main.c **** }
 508:Core/Src/main.c **** 
 509:Core/Src/main.c **** static inline float normaliseVoltage(int16_t adc_signed){
 510:Core/Src/main.c ****     return adcToVoltsActual(adc_signed) / V_PEAK_NOM;       // normalize to ±1.0 like r_t
 511:Core/Src/main.c **** }
 512:Core/Src/main.c **** 
ARM GAS  /tmp/ccsvDO2Z.s 			page 12


 513:Core/Src/main.c **** /**
 514:Core/Src/main.c ****  * @param adc_signed ADC1 differential reading, zero-centered (see DifferentialCode)
 515:Core/Src/main.c ****  */
 516:Core/Src/main.c **** static inline float Execute_HCA_Control(int16_t adc_signed, uint8_t update)
 517:Core/Src/main.c **** {
 518:Core/Src/main.c ****     static uint32_t step_fundamental = (uint32_t)((50.0f / (2.0f*SWITCH_RATE)) * 4294967296.0f);
 519:Core/Src/main.c ****     static uint32_t angle_fundamental = 0;
 520:Core/Src/main.c **** 
 521:Core/Src/main.c ****     uint32_t theta = angle_fundamental;
 522:Core/Src/main.c ****     float r_t = HCA_fastSin(theta)*0.8f;
 523:Core/Src/main.c **** 
 524:Core/Src/main.c ****     float error = r_t - (float)normaliseVoltage(adc_signed);
 525:Core/Src/main.c ****     float hca_out = HCA_Process(&hca, error);
 526:Core/Src/main.c **** 
 527:Core/Src/main.c ****     angle_fundamental += step_fundamental;
 528:Core/Src/main.c **** 
 529:Core/Src/main.c ****     if ((update & 0x1) == 0) {
 530:Core/Src/main.c ****       USPWM(htim8.Instance, hca_out, ARR_VAL, MODULATION_INDEX);  // modulation_index=1.0, already 
 531:Core/Src/main.c ****     }
 532:Core/Src/main.c **** 
 533:Core/Src/main.c ****     return error;
 534:Core/Src/main.c **** }
