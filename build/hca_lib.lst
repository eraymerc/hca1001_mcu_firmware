  46:Core/Src/hca_lib.c **** /**
  47:Core/Src/hca_lib.c ****  * @brief Sine lookup table used for DDS-based phasor generation
  48:Core/Src/hca_lib.c ****  *
  49:Core/Src/hca_lib.c ****  * The table covers one full electrical period [0, 2π).
  50:Core/Src/hca_lib.c ****  */
  51:Core/Src/hca_lib.c **** float HCA_sin_table[LUT_SIZE];
  52:Core/Src/hca_lib.c **** 
  53:Core/Src/hca_lib.c **** /**
  54:Core/Src/hca_lib.c ****  * @brief LUT initialization flag
  55:Core/Src/hca_lib.c ****  *
  56:Core/Src/hca_lib.c ****  * Ensures the lookup table is generated only once.
  57:Core/Src/hca_lib.c ****  */
  58:Core/Src/hca_lib.c **** static uint8_t is_lut_initialized = 0;
  59:Core/Src/hca_lib.c **** 
  60:Core/Src/hca_lib.c **** // ============================================================
  61:Core/Src/hca_lib.c **** // Internal complex math helper functions
  62:Core/Src/hca_lib.c **** // ============================================================
  63:Core/Src/hca_lib.c **** 
  64:Core/Src/hca_lib.c **** /**
  65:Core/Src/hca_lib.c ****  * @brief Add two complex numbers
  66:Core/Src/hca_lib.c ****  */
  67:Core/Src/hca_lib.c **** static inline Complex_t Complex_Add(Complex_t a, Complex_t b) {
  68:Core/Src/hca_lib.c ****     Complex_t res;
  69:Core/Src/hca_lib.c ****     res.real = a.real + b.real;
  70:Core/Src/hca_lib.c ****     res.imag = a.imag + b.imag;
  71:Core/Src/hca_lib.c ****     return res;
  72:Core/Src/hca_lib.c **** }
  73:Core/Src/hca_lib.c **** 
  74:Core/Src/hca_lib.c **** /**
  75:Core/Src/hca_lib.c ****  * @brief Multiply two complex numbers
  76:Core/Src/hca_lib.c ****  *
  77:Core/Src/hca_lib.c ****  * (a_r + j a_i) * (b_r + j b_i)
  78:Core/Src/hca_lib.c ****  */
  79:Core/Src/hca_lib.c **** static inline Complex_t Complex_Mult(Complex_t a, Complex_t b) {
  80:Core/Src/hca_lib.c ****     Complex_t res;
  81:Core/Src/hca_lib.c ****     res.real = (a.real * b.real) - (a.imag * b.imag);
  82:Core/Src/hca_lib.c ****     res.imag = (a.real * b.imag) + (a.imag * b.real);
  83:Core/Src/hca_lib.c ****     return res;
  84:Core/Src/hca_lib.c **** }
  85:Core/Src/hca_lib.c **** 
  86:Core/Src/hca_lib.c **** /**
ARM GAS  /tmp/ccHyCVKC.s 			page 3


  87:Core/Src/hca_lib.c ****  * @brief Scale a complex number by a real scalar
  88:Core/Src/hca_lib.c ****  */
  89:Core/Src/hca_lib.c **** static inline Complex_t Complex_Scale(Complex_t a, float scalar) {
  90:Core/Src/hca_lib.c ****     Complex_t res;
  91:Core/Src/hca_lib.c ****     res.real = a.real * scalar;
  92:Core/Src/hca_lib.c ****     res.imag = a.imag * scalar;
  93:Core/Src/hca_lib.c ****     return res;
  94:Core/Src/hca_lib.c **** }
  95:Core/Src/hca_lib.c **** 
