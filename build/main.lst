 870:Core/Src/main.c ****         cal_sum_raw_sin += raw_volts * cal_last_sin;
 871:Core/Src/main.c ****         cal_sum_cmd     += cal_last_command;
 872:Core/Src/main.c ****         cal_sum_cmd_sin += cal_last_command * cal_last_sin;
 873:Core/Src/main.c ****     }
 874:Core/Src/main.c **** 
 875:Core/Src/main.c ****     if (--cal_samples_left == 0U) {
 876:Core/Src/main.c ****         if (cal_state == CAL_SETTLING) {
 877:Core/Src/main.c ****             cal_sum_raw = cal_sum_raw_sin = cal_sum_cmd = cal_sum_cmd_sin = 0.0f;
 878:Core/Src/main.c ****             cal_samples_left = CAL_MEASURE_CYCLES * CAL_SAMPLES_PER_CYCLE;
 879:Core/Src/main.c ****             cal_state = CAL_MEASURING;
 880:Core/Src/main.c ****         } else {
 881:Core/Src/main.c ****             cal_state = CAL_COMPLETE;  // set last: it is what releases the results
