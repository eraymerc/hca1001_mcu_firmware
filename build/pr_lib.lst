 151:Core/Src/pr_lib.c ****         }
 152:Core/Src/pr_lib.c **** 
 153:Core/Src/pr_lib.c ****         // ----------------------------------------------------
 154:Core/Src/pr_lib.c ****         // Numerator: u = Ts*Ki*(cos(phi)*e[n] - cos(phi - wTs)*e[n-1])
 155:Core/Src/pr_lib.c ****         // ----------------------------------------------------
 156:Core/Src/pr_lib.c ****         float u = ch->b0 * de + ch->db * e_prev;
 157:Core/Src/pr_lib.c **** 
 158:Core/Src/pr_lib.c ****         // ----------------------------------------------------
 159:Core/Src/pr_lib.c ****         // Denominator, delta form: y[n] = (2-eps)y[n-1] - y[n-2] + u[n]
 160:Core/Src/pr_lib.c ****         // ----------------------------------------------------
 161:Core/Src/pr_lib.c ****         float y_prev = ch->y;
 162:Core/Src/pr_lib.c ****         float d = ch->d - ch->eps * y_prev + u;
 163:Core/Src/pr_lib.c ****         float y = y_prev + d;
 164:Core/Src/pr_lib.c **** 
 165:Core/Src/pr_lib.c ****         // ----------------------------------------------------
 166:Core/Src/pr_lib.c ****         // Anti-windup: cap the resonator's amplitude at output_limit.
 167:Core/Src/pr_lib.c ****         // A^2 = (d^2 + eps*y*(y - d)) / sin^2(wTs). Scaling d and y together
 168:Core/Src/pr_lib.c ****         // shrinks the oscillation without touching its frequency or phase.
