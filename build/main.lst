 783:Core/Src/main.c **** /* ---- Sensor calibration ---------------------------------------------------
 784:Core/Src/main.c ****  *
 785:Core/Src/main.c ****  * What it solves for: the two coefficients in
 786:Core/Src/main.c ****  *
 787:Core/Src/main.c ****  *     volts = adcToVoltsRaw(adc) * gain_cal + dc_cal
 788:Core/Src/main.c ****  *
 789:Core/Src/main.c ****  * The nominal sensor transfer function (SENSOR_GAIN) is derived from resistor
 790:Core/Src/main.c ****  * values and an amplifier gain, so it is off by a few percent in any real
 791:Core/Src/main.c ****  * build -- which is exactly what the hand-tuned GAIN_CAL_DEFAULT/DC_CAL_DEFAULT
 792:Core/Src/main.c ****  * were compensating for. This measures them instead.
 793:Core/Src/main.c ****  *
 794:Core/Src/main.c ****  * The reference it calibrates against is the modulator itself. Over one
 795:Core/Src/main.c ****  * fundamental cycle the bridge's average output is
 796:Core/Src/main.c ****  *
 797:Core/Src/main.c ****  *     v_true(t) = Vdc * MODULATION_INDEX * u(t)
 798:Core/Src/main.c ****  *
 799:Core/Src/main.c ****  * where u(t) is the command USPWM was given (cal_last_command). Vdc is the one
 800:Core/Src/main.c ****  * quantity the firmware cannot observe, which is why the host has to supply it.
 801:Core/Src/main.c ****  * Correlating both u(t) and the uncalibrated measurement against the same sine
 802:Core/Src/main.c ****  * the control loop runs on gives the fundamental component of each:
 803:Core/Src/main.c ****  *
 804:Core/Src/main.c ****  *     peak = 2 * mean(x(t) * sin(theta)),   dc = mean(x(t))
 805:Core/Src/main.c ****  *
 806:Core/Src/main.c ****  * and the two coefficients follow directly:
 807:Core/Src/main.c ****  *
 808:Core/Src/main.c ****  *     gain_cal = Vdc*MODULATION_INDEX*u_peak / raw_peak
 809:Core/Src/main.c ****  *     dc_cal   = Vdc*MODULATION_INDEX*u_dc - gain_cal*raw_dc
 810:Core/Src/main.c ****  *
 811:Core/Src/main.c ****  * Because it correlates the *command*, it works identically open loop (where
 812:Core/Src/main.c ****  * u is the reference straight through) and closed loop (where the controller
 813:Core/Src/main.c ****  * has already moved u to whatever the load needs) -- in both cases u is what
 814:Core/Src/main.c ****  * the bridge actually switched on. Closed loop the result is only as good as
 815:Core/Src/main.c ****  * the loop's tracking, so run it on a settled loop.
 816:Core/Src/main.c ****  *
 817:Core/Src/main.c ****  * The window is a whole number of fundamental cycles: that is what makes the
 818:Core/Src/main.c ****  * sine correlation orthogonal to the harmonics and the mean orthogonal to the
 819:Core/Src/main.c ****  * fundamental. A settling stretch is discarded first so a reference multiplier
 820:Core/Src/main.c ****  * that changed a moment ago is not averaged in half-applied. */
 821:Core/Src/main.c **** 
 822:Core/Src/main.c **** #define CAL_FUNDAMENTAL_HZ    50.0f
 823:Core/Src/main.c **** #define CAL_SAMPLE_RATE_HZ    (2.0f * SWITCH_RATE)  /**< the ADC ISR rate, 40kHz */
 824:Core/Src/main.c **** #define CAL_SAMPLES_PER_CYCLE ((uint32_t)(CAL_SAMPLE_RATE_HZ / CAL_FUNDAMENTAL_HZ))
 825:Core/Src/main.c **** #define CAL_SETTLE_CYCLES     10U
 826:Core/Src/main.c **** #define CAL_MEASURE_CYCLES    20U   /**< 0.4s of averaging, plus 0.2s settling */
 827:Core/Src/main.c **** 
ARM GAS  /tmp/ccZNkETD.s 			page 16


 828:Core/Src/main.c **** /** Plausible DC bus range. Outside this the operator has fat-fingered the
 829:Core/Src/main.c ****  *  entry, and a wrong Vdc scales the gain wrong by exactly that factor. */
 830:Core/Src/main.c **** #define CAL_VDC_MIN            10.0f
 831:Core/Src/main.c **** #define CAL_VDC_MAX          1000.0f
 832:Core/Src/main.c **** 
 833:Core/Src/main.c **** /** A commanded or sensed fundamental smaller than this is noise, not a
 834:Core/Src/main.c ****  *  measurement -- dividing by it would produce a nonsense gain. Sensed is in
 835:Core/Src/main.c ****  *  volts at the (uncalibrated) sensor, commanded is in per-unit duty. */
 836:Core/Src/main.c **** #define CAL_MIN_RAW_PEAK       5.0f
 837:Core/Src/main.c **** #define CAL_MIN_CMD_PEAK       0.05f
 838:Core/Src/main.c **** 
 839:Core/Src/main.c **** /** Correction the result must land inside. The nominal transfer function is
 840:Core/Src/main.c ****  *  derived from real component values, so anything beyond a 4x disagreement
 841:Core/Src/main.c ****  *  means the setup is wrong (wrong Vdc, sensor on the wrong node, output not
 842:Core/Src/main.c ****  *  switching), not that the sensor needs that much correction. */
 843:Core/Src/main.c **** #define CAL_GAIN_MIN           0.25f
 844:Core/Src/main.c **** #define CAL_GAIN_MAX           4.0f
 845:Core/Src/main.c **** 
 846:Core/Src/main.c **** enum { CAL_IDLE = 0, CAL_SETTLING, CAL_MEASURING, CAL_COMPLETE };
 847:Core/Src/main.c **** 
 848:Core/Src/main.c **** /** Written by the ISR, polled by the main loop -- volatile so the poll loop
 849:Core/Src/main.c ****  *  cannot hoist the read. */
 850:Core/Src/main.c **** static volatile uint8_t  cal_state = CAL_IDLE;
 851:Core/Src/main.c **** static volatile uint32_t cal_samples_left = 0;
 852:Core/Src/main.c **** 
 853:Core/Src/main.c **** /* Accumulators. ISR-owned while measuring; the main loop only reads them once
 854:Core/Src/main.c ****  * cal_state has become CAL_COMPLETE, which the ISR sets last. Plain floats:
 855:Core/Src/main.c ****  * ~16000 samples of a few hundred volts sum to ~1e6, and float carries that
 856:Core/Src/main.c ****  * with ~1e-7 relative error -- four orders of magnitude below the sensor
 857:Core/Src/main.c ****  * tolerance being measured. */
