 878:Core/Src/main.c ****             != coeff_rx[REF_CMD_PAYLOAD_LEN - 1U]) {
 879:Core/Src/main.c ****         return; // corrupted on the wire; the host re-sends after its ack times out
 880:Core/Src/main.c ****     }
 881:Core/Src/main.c **** 
 882:Core/Src/main.c ****     float value;
 883:Core/Src/main.c ****     /* memcpy rather than a cast: coeff_rx is byte-aligned, see ApplyCoeffCommand. */
 884:Core/Src/main.c ****     memcpy(&value, &coeff_rx[0], sizeof(float));
 885:Core/Src/main.c **** 
 886:Core/Src/main.c ****     /* Rejects NaN too -- both comparisons in SetReferenceMultiplier are false
 887:Core/Src/main.c ****      * for it, so screen it out here rather than letting it reach the ISR. */
 888:Core/Src/main.c ****     if (value != value) {
 889:Core/Src/main.c ****         return;
 890:Core/Src/main.c ****     }
 891:Core/Src/main.c **** 
 892:Core/Src/main.c ****     SetReferenceMultiplier(value);
