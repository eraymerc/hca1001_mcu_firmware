 329:Core/Src/main.c **** /**
 330:Core/Src/main.c ****  * Turn one normalised leg reference (-1..+1, where +-1 is +-VDC/2) into a
 331:Core/Src/main.c ****  * center-aligned compare value. This replaces the triangleWave() comparator
 332:Core/Src/main.c ****  * of PWM_generator_3phase: the timer's up/down counter *is* the carrier, so
 333:Core/Src/main.c ****  * the software only has to place the crossing point.
 334:Core/Src/main.c ****  *   duty = (ARR/2) * (1 + m)   ->  m = 0 gives 50%
 335:Core/Src/main.c ****  */
 336:Core/Src/main.c **** static inline uint32_t leg_compare(float m)
 337:Core/Src/main.c **** {
 338:Core/Src/main.c ****     if (m >  1.0f) { m =  1.0f; }
 339:Core/Src/main.c ****     if (m < -1.0f) { m = -1.0f; }
 340:Core/Src/main.c ****     return (uint32_t)(((float)ARR_VAL * 0.5f) * (1.0f + m));
 341:Core/Src/main.c **** }
 342:Core/Src/main.c **** 
