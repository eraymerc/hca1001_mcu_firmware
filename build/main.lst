 830:Core/Src/main.c **** static void SendAllCoeffFrames(void)
 831:Core/Src/main.c **** {
 832:Core/Src/main.c ****     HCA_Handle_t *h = (HCA_Handle_t*)&hca;
 833:Core/Src/main.c ****     uint8_t count = h->active_channel_count;
 834:Core/Src/main.c ****     for (uint8_t i = 0; i < count; i++) {
 835:Core/Src/main.c ****         SendCoeffFrame(i, count, &h->channels[i]);
 836:Core/Src/main.c ****     }
 837:Core/Src/main.c **** }
 838:Core/Src/main.c **** 
 839:Core/Src/main.c **** /** Validate a fully received SET_COEFF payload and push it into the controller. */
 840:Core/Src/main.c **** static void ApplyCoeffCommand(void)
 841:Core/Src/main.c **** {
 842:Core/Src/main.c ****     if (CoeffChecksum(coeff_rx, COEFF_CMD_PAYLOAD_LEN - 1U)
 843:Core/Src/main.c ****             != coeff_rx[COEFF_CMD_PAYLOAD_LEN - 1U]) {
 844:Core/Src/main.c ****         return; // corrupted on the wire; the host re-sends after its ack times out
 845:Core/Src/main.c ****     }
 846:Core/Src/main.c **** 
 847:Core/Src/main.c ****     uint8_t   order = coeff_rx[0];
 848:Core/Src/main.c ****     Complex_t kp, ki;
 849:Core/Src/main.c ****     /* memcpy rather than a cast: coeff_rx is byte-aligned and the FPU's VLDR
 850:Core/Src/main.c ****      * faults on an unaligned float load. */
 851:Core/Src/main.c ****     memcpy(&kp.real, &coeff_rx[1],  sizeof(float));
 852:Core/Src/main.c ****     memcpy(&kp.imag, &coeff_rx[5],  sizeof(float));
 853:Core/Src/main.c ****     memcpy(&ki.real, &coeff_rx[9],  sizeof(float));
 854:Core/Src/main.c ****     memcpy(&ki.imag, &coeff_rx[13], sizeof(float));
 855:Core/Src/main.c **** 
 856:Core/Src/main.c ****     /* Gains only -- this never creates a channel. The set of active channels is
 857:Core/Src/main.c ****      * fixed at boot by the HCA_Add_Channel calls in main(), so the ISR's
 858:Core/Src/main.c ****      * per-sample workload cannot change underneath it while running.
 859:Core/Src/main.c ****      *
 860:Core/Src/main.c ****      * Safe from the main loop; see the thread-safety note on HCA_UpdateChannel.
 861:Core/Src/main.c ****      * An order with no channel is ignored there, and the absent echo below is
 862:Core/Src/main.c ****      * what tells the host the write did not land. */
 863:Core/Src/main.c ****     HCA_Handle_t *h = (HCA_Handle_t*)&hca;
 864:Core/Src/main.c ****     HCA_UpdateChannel(h, order, kp, ki);
 865:Core/Src/main.c **** 
 866:Core/Src/main.c ****     for (uint8_t i = 0; i < h->active_channel_count; i++) {
 867:Core/Src/main.c ****         if (h->channels[i].harmonic_order == order) {
 868:Core/Src/main.c ****             SendCoeffFrame(i, h->active_channel_count, &h->channels[i]);
 869:Core/Src/main.c ****             return;
 870:Core/Src/main.c ****         }
 871:Core/Src/main.c ****     }
 872:Core/Src/main.c **** }
 873:Core/Src/main.c **** 
 874:Core/Src/main.c **** /** Validate a fully received SET_REF payload and apply it. */
 875:Core/Src/main.c **** static void ApplyRefCommand(void)
