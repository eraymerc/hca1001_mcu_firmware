 542:Core/Src/main.c **** /** Producer side (called from ADC ISR). Drops the sample if the FIFO is full. */
 543:Core/Src/main.c **** static inline void PushStreamFrame(float voltage, float error)
 544:Core/Src/main.c **** {
 545:Core/Src/main.c ****     uint16_t next_head = (uint16_t)((stream_fifo_head + 1U) & STREAM_FIFO_MASK);
 546:Core/Src/main.c ****     if (next_head == stream_fifo_tail) {
 547:Core/Src/main.c ****         return; // consumer (UART) can't keep up, drop this sample
 548:Core/Src/main.c ****     }
 549:Core/Src/main.c **** 
 550:Core/Src/main.c ****     AdcStreamFrame_t *f = &stream_fifo[stream_fifo_head];
 551:Core/Src/main.c ****     f->sync0        = STREAM_SYNC0;
 552:Core/Src/main.c ****     f->sync1        = STREAM_SYNC1;
 553:Core/Src/main.c ****     f->seq          = stream_seq++;
 554:Core/Src/main.c ****     f->timestamp_ms = HAL_GetTick();
 555:Core/Src/main.c ****     f->voltage      = voltage;
 556:Core/Src/main.c ****     f->error        = error;
ARM GAS  /tmp/cciJjOdM.s 			page 14


 557:Core/Src/main.c ****     f->checksum     = StreamChecksum(f);
 558:Core/Src/main.c **** 
 559:Core/Src/main.c ****     stream_fifo_head = next_head;
 560:Core/Src/main.c **** }
