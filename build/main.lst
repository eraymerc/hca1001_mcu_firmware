  36:Core/Src/main.c **** /* USER CODE BEGIN PD */
  37:Core/Src/main.c **** #define ARR_VAL 4249
  38:Core/Src/main.c **** #define SWITCH_RATE 20000.0f // Hz, TIM8 carrier frequency (170MHz / (2*(ARR_VAL+1)))
  39:Core/Src/main.c **** 
  40:Core/Src/main.c **** /** Every 40kHz ADC sample is streamed, no decimation: 59-byte frames of 8
  41:Core/Src/main.c ****  *  samples at 5,000 frames/s is 295,000 B/s on a link good for 800,000 B/s
  42:Core/Src/main.c ****  *  (8,000,000 baud, 8N1), i.e. about 37% of the wire. A frame takes ~74us to
  43:Core/Src/main.c ****  *  send against the 200us it takes to fill, so the blocking transmit in the
  44:Core/Src/main.c ****  *  main loop keeps well ahead of the ISR. */
  45:Core/Src/main.c **** 
  46:Core/Src/main.c **** /** Streaming frame ring buffer depth (must be a power of two) */
  47:Core/Src/main.c **** /* 256 frames is 2048 samples -- ~51ms of slack at 40kHz, for 15KB of RAM. It
  48:Core/Src/main.c ****  * only has to ride out main-loop stalls (command replies); a host that stops
  49:Core/Src/main.c ****  * reading loses bytes in the ST-LINK, which no device-side buffer can help. */
  50:Core/Src/main.c **** #define STREAM_FIFO_LEN  256U
  51:Core/Src/main.c **** #define STREAM_FIFO_MASK (STREAM_FIFO_LEN - 1U)
  52:Core/Src/main.c **** 
  53:Core/Src/main.c **** /** Fixed-point scales of the int16 stream fields (see AdcStreamFrame_t). Both
  54:Core/Src/main.c ****  *  are finer than one ADC code -- ~0.31V, or ~0.0015 p.u. at V_PEAK_NOM -- so
  55:Core/Src/main.c ****  *  quantising to them loses nothing the ADC resolved. */
  56:Core/Src/main.c **** #define STREAM_VOLT_SCALE 16.0f    /**< voltage: 1/16 V per count, +-2048V range */
  57:Core/Src/main.c **** #define STREAM_PU_SCALE   2048.0f  /**< reference, error: 1/2048 p.u. per count, +-16 p.u. range */
  58:Core/Src/main.c **** 
  59:Core/Src/main.c **** /** LPUART1 RX ring filled by DMA, drained in the main loop (must be a power of two).
  60:Core/Src/main.c ****  *
  61:Core/Src/main.c ****  *  Polling HAL_UART_Receive() a byte at a time cannot keep up here: one byte is
  62:Core/Src/main.c ****  *  4.77us at 2,097,000 baud, while the main loop can sit inside a blocking
  63:Core/Src/main.c ****  *  HAL_UART_Transmit for ~90us per stream frame and is preempted by the 40kHz
  64:Core/Src/main.c ****  *  ADC ISR every 25us. A single-byte command survives that (it just waits in
  65:Core/Src/main.c ****  *  RDR), but every byte after the first in a multi-byte command is overrun and
  66:Core/Src/main.c ****  *  lost -- which is why SET_COEFF payloads never completed. DMA takes the CPU
  67:Core/Src/main.c ****  *  out of the capture path entirely, so main-loop latency no longer matters.
  68:Core/Src/main.c ****  *
  69:Core/Src/main.c ****  *  64 bytes is over three SET_COEFF commands' worth of slack. */
  70:Core/Src/main.c **** #define UART_RX_DMA_LEN  64U
  71:Core/Src/main.c **** #define UART_RX_DMA_MASK (UART_RX_DMA_LEN - 1U)
  72:Core/Src/main.c **** #define MODULATION_INDEX 0.85f
  73:Core/Src/main.c **** 
  74:Core/Src/main.c **** #define IS_OPENLOOP 1
  75:Core/Src/main.c **** 
  76:Core/Src/main.c **** /** Ceiling on reference_multiplier when running open loop. The reference is
  77:Core/Src/main.c ****  *  fed straight to the modulator there, so it may exceed MODULATION_INDEX --
  78:Core/Src/main.c ****  *  overmodulation is a legitimate open-loop test point. Closed loop the
  79:Core/Src/main.c ****  *  controller needs headroom above the reference to correct with, so the
  80:Core/Src/main.c ****  *  limit is MODULATION_INDEX itself; see SetReferenceMultiplier. */
  81:Core/Src/main.c **** #define REF_MULT_OPENLOOP_MAX 1.0f
  82:Core/Src/main.c **** /* USER CODE END PD */
  83:Core/Src/main.c **** 
  84:Core/Src/main.c **** /* Private macro -------------------------------------------------------------*/
  85:Core/Src/main.c **** /* USER CODE BEGIN PM */
  86:Core/Src/main.c **** 
