 845:Core/Src/main.c **** /** Validate a fully received SET_COEFF payload and push it into the controller. */
 846:Core/Src/main.c **** static void ApplyCoeffCommand(void)
 847:Core/Src/main.c **** {
 848:Core/Src/main.c ****     if (CoeffChecksum(coeff_rx, COEFF_CMD_PAYLOAD_LEN - 1U)
 849:Core/Src/main.c ****             != coeff_rx[COEFF_CMD_PAYLOAD_LEN - 1U]) {
 850:Core/Src/main.c ****         return; // corrupted on the wire; the host re-sends after its ack times out
 851:Core/Src/main.c ****     }
 852:Core/Src/main.c **** 
 853:Core/Src/main.c ****     uint8_t   order = coeff_rx[0];
 854:Core/Src/main.c ****     Complex_t kp, ki;
