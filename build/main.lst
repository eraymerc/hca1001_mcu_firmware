 719:Core/Src/main.c **** 
 720:Core/Src/main.c ****     float r_t = HCA_fastSin(angle_fundamental)*reference_multiplier;
 721:Core/Src/main.c ****     angle_fundamental += step_fundamental;
 722:Core/Src/main.c ****     return r_t;
 723:Core/Src/main.c **** }
