  54:Core/Src/hca_lib.c ****  * @brief LUT initialization flag
  55:Core/Src/hca_lib.c ****  *
  56:Core/Src/hca_lib.c ****  * Ensures the lookup table is generated only once.
  57:Core/Src/hca_lib.c ****  */
  58:Core/Src/hca_lib.c **** static uint8_t is_lut_initialized = 0;
