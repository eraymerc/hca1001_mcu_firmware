1008:Core/Src/main.c **** /** Validate a fully received SET_REF payload and apply it. */
1009:Core/Src/main.c **** static void ApplyRefCommand(void)
1010:Core/Src/main.c **** {
1011:Core/Src/main.c ****     if (CoeffChecksum(coeff_rx, REF_CMD_PAYLOAD_LEN - 1U)
1012:Core/Src/main.c ****             != coeff_rx[REF_CMD_PAYLOAD_LEN - 1U]) {
1013:Core/Src/main.c ****         return; // corrupted on the wire; the host re-sends after its ack times out
1014:Core/Src/main.c ****     }
1015:Core/Src/main.c **** 
1016:Core/Src/main.c ****     float value;
1017:Core/Src/main.c ****     /* memcpy rather than a cast: coeff_rx is byte-aligned, see ApplyCoeffCommand. */
1018:Core/Src/main.c ****     memcpy(&value, &coeff_rx[0], sizeof(float));
1019:Core/Src/main.c **** 
1020:Core/Src/main.c ****     /* Rejects NaN too -- both comparisons in SetReferenceMultiplier are false
1021:Core/Src/main.c ****      * for it, so screen it out here rather than letting it reach the ISR. */
1022:Core/Src/main.c ****     if (value != value) {
1023:Core/Src/main.c ****         return;
1024:Core/Src/main.c ****     }
1025:Core/Src/main.c **** 
1026:Core/Src/main.c ****     SetReferenceMultiplier(value);
1027:Core/Src/main.c ****     SendRefFrame();  // echoes the clamped value, which is the host's ack
1028:Core/Src/main.c **** }
