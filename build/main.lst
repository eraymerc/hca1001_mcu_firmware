 698:Core/Src/main.c **** 
 699:Core/Src/main.c **** /** Range-check happens here, on the way in -- the Execute_*_Control functions
 700:Core/Src/main.c ****  *  stay a pure hot path and just use whatever value is standing.
 701:Core/Src/main.c ****  *  @return the value actually applied, which is the request clamped to range. */
 702:Core/Src/main.c **** static float SetReferenceMultiplier(float value)
 703:Core/Src/main.c **** {
 704:Core/Src/main.c ****     const float limit = ReferenceMultiplierLimit();
 705:Core/Src/main.c **** 
 706:Core/Src/main.c ****     if (value < 0.0f)  { value = 0.0f; }
 707:Core/Src/main.c ****     if (value > limit) { value = limit; }
 708:Core/Src/main.c **** 
 709:Core/Src/main.c ****     reference_multiplier = value;
 710:Core/Src/main.c ****     return value;
 711:Core/Src/main.c **** }
