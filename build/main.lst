 779:Core/Src/main.c **** /** Round to the nearest count and saturate, so an out-of-range value pins at
 780:Core/Src/main.c ****  *  the rail instead of wrapping to the opposite sign. */
 781:Core/Src/main.c **** static inline int16_t ToStreamFixed(float value, float scale)
 782:Core/Src/main.c **** {
 783:Core/Src/main.c ****     float scaled = value * scale;
 784:Core/Src/main.c ****     if (scaled >=  32767.0f) { return  32767; }
 785:Core/Src/main.c ****     if (scaled <= -32768.0f) { return -32768; }
 786:Core/Src/main.c ****     return (int16_t)(scaled + ((scaled >= 0.0f) ? 0.5f : -0.5f));
 787:Core/Src/main.c **** }
