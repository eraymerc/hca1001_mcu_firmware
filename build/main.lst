 718:Core/Src/main.c **** 
 719:Core/Src/main.c **** /** One ramp step, called from the ADC ISR before the reference is used.
 720:Core/Src/main.c ****  *  Converges exactly: the final step is clamped to the target rather than
 721:Core/Src/main.c ****  *  overshooting it, so the comparison settles and stops costing anything. */
 722:Core/Src/main.c **** static inline void StepReferenceRamp(void)
 723:Core/Src/main.c **** {
