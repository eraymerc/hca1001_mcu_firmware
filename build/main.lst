1125:Core/Src/main.c **** /** Arm the ISR-side accumulator. Nothing is measured or applied here -- the
1126:Core/Src/main.c ****  *  run takes CAL_SETTLE_CYCLES + CAL_MEASURE_CYCLES fundamental periods, and
1127:Core/Src/main.c ****  *  PollCalibration finishes it without blocking the stream pump. */
1128:Core/Src/main.c **** static void StartCalibration(float vdc)
1129:Core/Src/main.c **** {
1130:Core/Src/main.c ****     if (cal_pending) {
1131:Core/Src/main.c ****         SendCalFrame(CAL_STATUS_BUSY, cal_vdc, 0.0f, 0.0f, 0.0f);
1132:Core/Src/main.c ****         return;
1133:Core/Src/main.c ****     }
1134:Core/Src/main.c ****     if (!(vdc >= CAL_VDC_MIN && vdc <= CAL_VDC_MAX)) {  // false for NaN too
1135:Core/Src/main.c ****         SendCalFrame(CAL_STATUS_BAD_VDC, vdc, 0.0f, 0.0f, 0.0f);
1136:Core/Src/main.c ****         return;
1137:Core/Src/main.c ****     }
1138:Core/Src/main.c **** 
1139:Core/Src/main.c ****     cal_vdc = vdc;
1140:Core/Src/main.c ****     cal_pending = 1;
1141:Core/Src/main.c ****     cal_deadline_ms = HAL_GetTick() + CAL_TIMEOUT_MS;
1142:Core/Src/main.c **** 
1143:Core/Src/main.c ****     cal_samples_left = CAL_SETTLE_CYCLES * CAL_SAMPLES_PER_CYCLE;
1144:Core/Src/main.c ****     cal_state = CAL_SETTLING;  // set last, it is what starts the ISR accumulating
1145:Core/Src/main.c **** }
1146:Core/Src/main.c **** 
1147:Core/Src/main.c **** /** Polled from the main loop. Does the arithmetic, applies the result and
1148:Core/Src/main.c ****  *  reports it -- the reply frame is the host's completion notice. */
1149:Core/Src/main.c **** static void PollCalibration(void)
1150:Core/Src/main.c **** {
ARM GAS  /tmp/ccZNkETD.s 			page 32


1151:Core/Src/main.c ****     if (!cal_pending) {
1152:Core/Src/main.c ****         return;
1153:Core/Src/main.c ****     }
1154:Core/Src/main.c **** 
1155:Core/Src/main.c ****     if (cal_state != CAL_COMPLETE) {
1156:Core/Src/main.c ****         if ((int32_t)(HAL_GetTick() - cal_deadline_ms) >= 0) {
1157:Core/Src/main.c ****             cal_state = CAL_IDLE;   // the ADC ISR is not running; nothing was measured
1158:Core/Src/main.c ****             cal_pending = 0;
1159:Core/Src/main.c ****             SendCalFrame(CAL_STATUS_NO_SIGNAL, cal_vdc, 0.0f, 0.0f, 0.0f);
1160:Core/Src/main.c ****         }
1161:Core/Src/main.c ****         return;
1162:Core/Src/main.c ****     }
1163:Core/Src/main.c **** 
1164:Core/Src/main.c ****     const float n = (float)(CAL_MEASURE_CYCLES * CAL_SAMPLES_PER_CYCLE);
1165:Core/Src/main.c **** 
1166:Core/Src/main.c ****     /* Fundamental component of each signal, from its correlation with the
1167:Core/Src/main.c ****      * loop's own sine over a whole number of cycles. */
1168:Core/Src/main.c ****     const float raw_dc   = cal_sum_raw / n;
1169:Core/Src/main.c ****     const float raw_peak = 2.0f * cal_sum_raw_sin / n;
1170:Core/Src/main.c ****     const float cmd_dc   = cal_sum_cmd / n;
1171:Core/Src/main.c ****     const float cmd_peak = 2.0f * cal_sum_cmd_sin / n;
1172:Core/Src/main.c **** 
1173:Core/Src/main.c ****     /* What the bridge must have put out to have been commanded that duty. */
1174:Core/Src/main.c ****     const float expected_peak = cal_vdc * MODULATION_INDEX * cmd_peak;
