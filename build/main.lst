 568:Core/Src/main.c **** // Manages the HCA loop 40kHz sample rate and 1kHz telemetry rate
 569:Core/Src/main.c **** volatile uint32_t tick_counter = 0;
 570:Core/Src/main.c **** void HAL_ADC_ConvCpltCallback(ADC_HandleTypeDef *hadc)
 571:Core/Src/main.c **** {
 572:Core/Src/main.c ****     if (hadc->Instance == ADC1)
 573:Core/Src/main.c ****     {
 574:Core/Src/main.c ****         int16_t v_adc_signed = DifferentialCode(adc1_raw); // voltage, differential
 575:Core/Src/main.c **** 
 576:Core/Src/main.c ****         tick_counter++;
 577:Core/Src/main.c **** 
 578:Core/Src/main.c ****         float error = Execute_HCA_Control(v_adc_signed, tick_counter);
 579:Core/Src/main.c **** 
