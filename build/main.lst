 699:Core/Src/main.c ****     const uint16_t len = (uint16_t)(sizeof(AdcStreamFrame_t) - sizeof(f->sync0)
 700:Core/Src/main.c ****                                      - sizeof(f->sync1) - sizeof(f->checksum));
 701:Core/Src/main.c ****     uint8_t sum = 0;
 702:Core/Src/main.c ****     for (uint16_t i = 0; i < len; i++) {
 703:Core/Src/main.c ****         sum += p[i];
 704:Core/Src/main.c ****     }
 705:Core/Src/main.c ****     return sum;
 706:Core/Src/main.c **** }
