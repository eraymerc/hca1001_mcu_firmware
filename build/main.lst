 569:Core/Src/main.c **** #define ADC_VREF              3.3f
 570:Core/Src/main.c **** #define ADC_FULL_SCALE_CODES  2048.0f  // ADC1 is differential; signed code -2048..2047 spans -VREF
 571:Core/Src/main.c **** #define V_PEAK_NOM            200.0f
 572:Core/Src/main.c **** 
 573:Core/Src/main.c **** /**
 574:Core/Src/main.c ****  * Sensor transfer function (measured/derived from the actual circuit):
 575:Core/Src/main.c ****  *   Vout_p = Vin * (250/22000) *  0.43 + 1.65V
 576:Core/Src/main.c ****  *   Vout_n = Vin * (250/22000) * -0.43 + 1.65V
 577:Core/Src/main.c ****  * Both differential pins are biased at 1.65V (VDDA/2) with the signal
 578:Core/Src/main.c ****  * riding symmetrically in opposite directions, so the differential the ADC
 579:Core/Src/main.c ****  * actually measures is:
 580:Core/Src/main.c ****  *   Vinp - Vinn = Vout_p - Vout_n = SENSOR_GAIN * Vin
 581:Core/Src/main.c ****  * where SENSOR_GAIN = 2 * (250/22000) * 0.43. The 1.65V bias on each pin
 582:Core/Src/main.c ****  * cancels out in the subtraction -- no bias removal needed in software.
 583:Core/Src/main.c ****  */
 584:Core/Src/main.c **** #define SENSOR_GAIN (2.0f * (250.0f / 44000.0f) * 0.4779f)
 585:Core/Src/main.c **** #define DC_CAL 21.5f
 586:Core/Src/main.c **** #define GAIN_CAL 172.0f/159.0f
 587:Core/Src/main.c **** 
 588:Core/Src/main.c **** /**
 589:Core/Src/main.c ****  * ADC1 in differential mode reports Vinp-Vinn as a 12-bit *straight offset
 590:Core/Src/main.c ****  * binary* code (0..4095, unsigned) -- NOT two's complement. Code 2048
 591:Core/Src/main.c ****  * (0x800) means Vinp-Vinn = 0V; 0 means -VREF; 4095 means ~+VREF. Center
 592:Core/Src/main.c ****  * it on zero by subtracting the half-scale offset.
 593:Core/Src/main.c ****  */
 594:Core/Src/main.c **** static inline int16_t DifferentialCode(uint16_t raw12)
 595:Core/Src/main.c **** {
 596:Core/Src/main.c ****     return (int16_t)raw12 - (int16_t)ADC_FULL_SCALE_CODES;
 597:Core/Src/main.c **** }
 598:Core/Src/main.c **** 
 599:Core/Src/main.c **** static inline float adcToVoltsActual(int16_t adc_signed){
ARM GAS  /tmp/cc3FokBo.s 			page 12


 600:Core/Src/main.c ****     float v_adc = (float)adc_signed * (ADC_VREF / ADC_FULL_SCALE_CODES); // differential volts at t
 601:Core/Src/main.c ****     return (v_adc / SENSOR_GAIN)*GAIN_CAL + DC_CAL;                                          // inv
 602:Core/Src/main.c **** }
 603:Core/Src/main.c **** 
 604:Core/Src/main.c **** static inline float normaliseVoltage(int16_t adc_signed){
 605:Core/Src/main.c ****     return adcToVoltsActual(adc_signed) / V_PEAK_NOM;       // normalize to ±1.0 like r_t
 606:Core/Src/main.c **** }
 607:Core/Src/main.c **** 
 608:Core/Src/main.c **** /**
 609:Core/Src/main.c ****  * @param adc_signed ADC1 differential reading, zero-centered (see DifferentialCode)
 610:Core/Src/main.c ****  */
 611:Core/Src/main.c **** static inline float Execute_HCA_Control(int16_t adc_signed, uint8_t update)
 612:Core/Src/main.c **** {
 613:Core/Src/main.c ****     static uint32_t step_fundamental = (uint32_t)((50.0f / (2.0f*SWITCH_RATE)) * 4294967296.0f);
 614:Core/Src/main.c ****     static uint32_t angle_fundamental = 0;
 615:Core/Src/main.c **** 
 616:Core/Src/main.c ****     uint32_t theta = angle_fundamental;
 617:Core/Src/main.c ****     float r_t = HCA_fastSin(theta)*0.8f;
 618:Core/Src/main.c **** 
 619:Core/Src/main.c ****     float error = r_t - (float)normaliseVoltage(adc_signed);
 620:Core/Src/main.c ****     float hca_out = HCA_Process(&hca, error);
 621:Core/Src/main.c **** 
 622:Core/Src/main.c ****     angle_fundamental += step_fundamental;
 623:Core/Src/main.c **** 
 624:Core/Src/main.c ****     if ((update & 0x1) == 0) {
 625:Core/Src/main.c ****       USPWM(htim8.Instance, hca_out, ARR_VAL, MODULATION_INDEX);  // modulation_index=1.0, already 
 626:Core/Src/main.c ****     }
 627:Core/Src/main.c **** 
 628:Core/Src/main.c ****     return error;
 629:Core/Src/main.c **** }
 630:Core/Src/main.c **** 
 631:Core/Src/main.c **** static uint8_t StreamChecksum(const AdcStreamFrame_t *f)
 632:Core/Src/main.c **** {
 633:Core/Src/main.c ****     const uint8_t *p = (const uint8_t*)&f->seq;
 634:Core/Src/main.c ****     const uint16_t len = (uint16_t)(sizeof(AdcStreamFrame_t) - sizeof(f->sync0)
 635:Core/Src/main.c ****                                      - sizeof(f->sync1) - sizeof(f->checksum));
 636:Core/Src/main.c ****     uint8_t sum = 0;
 637:Core/Src/main.c ****     for (uint16_t i = 0; i < len; i++) {
 638:Core/Src/main.c ****         sum += p[i];
 639:Core/Src/main.c ****     }
 640:Core/Src/main.c ****     return sum;
 641:Core/Src/main.c **** }
 642:Core/Src/main.c **** 
 643:Core/Src/main.c **** /* Batch under construction. Only the ISR touches it, so it needs no guarding. */
 644:Core/Src/main.c **** static AdcStreamFrame_t stream_accum;
 645:Core/Src/main.c **** static uint8_t          stream_accum_count = 0;
 646:Core/Src/main.c **** 
 647:Core/Src/main.c **** /**
 648:Core/Src/main.c ****  * Producer side (called from ADC ISR). Accumulates STREAM_BATCH_SAMPLES samples
 649:Core/Src/main.c ****  * and pushes them as one frame; drops the whole batch if the FIFO is full.
 650:Core/Src/main.c ****  *
 651:Core/Src/main.c ****  * seq is advanced only on a successful push, which is what lets the host tell
 652:Core/Src/main.c ****  * the two loss modes apart: a FIFO overflow here leaves seq contiguous but
 653:Core/Src/main.c ****  * slower than wall-clock, while bytes lost on the wire leave holes in seq.
 654:Core/Src/main.c ****  */
 655:Core/Src/main.c **** static inline void PushStreamFrame(float voltage, float error)
 656:Core/Src/main.c **** {
ARM GAS  /tmp/cc3FokBo.s 			page 13


 657:Core/Src/main.c ****     if (stream_accum_count == 0U) {
 658:Core/Src/main.c ****         stream_accum.timestamp_ms = HAL_GetTick();
 659:Core/Src/main.c ****     }
 660:Core/Src/main.c **** 
 661:Core/Src/main.c ****     stream_accum.samples[stream_accum_count].voltage = voltage;
 662:Core/Src/main.c ****     stream_accum.samples[stream_accum_count].error   = error;
 663:Core/Src/main.c **** 
 664:Core/Src/main.c ****     if (++stream_accum_count < STREAM_BATCH_SAMPLES) {
 665:Core/Src/main.c ****         return; // batch still filling
 666:Core/Src/main.c ****     }
 667:Core/Src/main.c ****     stream_accum_count = 0;
 668:Core/Src/main.c **** 
 669:Core/Src/main.c ****     uint16_t next_head = (uint16_t)((stream_fifo_head + 1U) & STREAM_FIFO_MASK);
