 548:Core/Src/main.c **** /** Producer side (called from ADC ISR). Drops the sample if the FIFO is full. */
 549:Core/Src/main.c **** static inline void PushStreamFrame(float voltage, float error)
 550:Core/Src/main.c **** {
 551:Core/Src/main.c ****     uint16_t next_head = (uint16_t)((stream_fifo_head + 1U) & STREAM_FIFO_MASK);
 552:Core/Src/main.c ****     if (next_head == stream_fifo_tail) {
 553:Core/Src/main.c ****         return; // consumer (UART) can't keep up, drop this sample
 554:Core/Src/main.c ****     }
 555:Core/Src/main.c **** 
 556:Core/Src/main.c ****     AdcStreamFrame_t *f = &stream_fifo[stream_fifo_head];
