 716:Core/Src/main.c **** /** 50Hz sine reference, scaled by reference_multiplier. Advances the phase by
 717:Core/Src/main.c ****  *  one sample on every call, so call it exactly once per ISR. */
 718:Core/Src/main.c **** static inline float NextReference(void)
 719:Core/Src/main.c **** {
 720:Core/Src/main.c ****     static uint32_t step_fundamental = (uint32_t)((50.0f / (2.0f*SWITCH_RATE)) * 4294967296.0f);
 721:Core/Src/main.c ****     static uint32_t angle_fundamental = 0;
 722:Core/Src/main.c **** 
 723:Core/Src/main.c ****     float r_t = HCA_fastSin(angle_fundamental)*reference_multiplier;
 724:Core/Src/main.c ****     angle_fundamental += step_fundamental;
 725:Core/Src/main.c ****     return r_t;
 726:Core/Src/main.c **** }
