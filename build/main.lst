 704:Core/Src/main.c **** /* Batch under construction. Only the ISR touches it, so it needs no guarding. */
 705:Core/Src/main.c **** static AdcStreamFrame_t stream_accum;
 706:Core/Src/main.c **** static uint8_t          stream_accum_count = 0;
 707:Core/Src/main.c **** 
 708:Core/Src/main.c **** /**
 709:Core/Src/main.c ****  * Producer side (called from ADC ISR). Accumulates STREAM_BATCH_SAMPLES samples
 710:Core/Src/main.c ****  * and pushes them as one frame; drops the whole batch if the FIFO is full.
 711:Core/Src/main.c ****  *
 712:Core/Src/main.c ****  * seq advances for every completed batch, pushed or dropped, so any missing
 713:Core/Src/main.c ****  * samples -- FIFO overflow here or bytes lost on the wire -- show up on the
ARM GAS  /tmp/ccJ0853N.s 			page 14


 714:Core/Src/main.c ****  * host as a hole in seq. At 40kHz a dropped frame is only 0.2ms, too short
 715:Core/Src/main.c ****  * for the 1ms timestamp to reveal, so seq is the only reliable gap marker.
 716:Core/Src/main.c ****  */
 717:Core/Src/main.c **** static inline void PushStreamFrame(float voltage, float reference, float error)
 718:Core/Src/main.c **** {
 719:Core/Src/main.c ****     if (stream_accum_count == 0U) {
 720:Core/Src/main.c ****         stream_accum.timestamp_ms = HAL_GetTick();
 721:Core/Src/main.c ****     }
 722:Core/Src/main.c **** 
 723:Core/Src/main.c ****     stream_accum.samples[stream_accum_count].voltage   = ToStreamFixed(voltage,   STREAM_VOLT_SCALE
 724:Core/Src/main.c ****     stream_accum.samples[stream_accum_count].reference = ToStreamFixed(reference, STREAM_PU_SCALE);
 725:Core/Src/main.c ****     stream_accum.samples[stream_accum_count].error     = ToStreamFixed(error,     STREAM_PU_SCALE);
 726:Core/Src/main.c **** 
 727:Core/Src/main.c ****     if (++stream_accum_count < STREAM_BATCH_SAMPLES) {
 728:Core/Src/main.c ****         return; // batch still filling
 729:Core/Src/main.c ****     }
 730:Core/Src/main.c ****     stream_accum_count = 0;
 731:Core/Src/main.c **** 
 732:Core/Src/main.c ****     uint32_t seq = stream_seq++;
 733:Core/Src/main.c **** 
 734:Core/Src/main.c ****     uint16_t next_head = (uint16_t)((stream_fifo_head + 1U) & STREAM_FIFO_MASK);
 735:Core/Src/main.c ****     if (next_head == stream_fifo_tail) {
 736:Core/Src/main.c ****         return; // consumer (UART) can't keep up, drop this batch
 737:Core/Src/main.c ****     }
 738:Core/Src/main.c **** 
 739:Core/Src/main.c ****     AdcStreamFrame_t *f = &stream_fifo[stream_fifo_head];
 740:Core/Src/main.c ****     *f              = stream_accum;
 741:Core/Src/main.c ****     f->sync0        = STREAM_SYNC0;
 742:Core/Src/main.c ****     f->sync1        = STREAM_SYNC1;
 743:Core/Src/main.c ****     f->seq          = seq;
 744:Core/Src/main.c ****     f->checksum     = StreamChecksum(f);
 745:Core/Src/main.c **** 
 746:Core/Src/main.c ****     stream_fifo_head = next_head;
 747:Core/Src/main.c **** }
