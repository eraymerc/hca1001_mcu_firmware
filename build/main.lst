 691:Core/Src/main.c **** 
 692:Core/Src/main.c **** /** Largest reference multiplier this build accepts, see CONTROL_TYPE above. */
 693:Core/Src/main.c **** static inline float ReferenceMultiplierLimit(void)
 694:Core/Src/main.c **** {
 695:Core/Src/main.c **** #if CONTROL_TYPE == CONTROL_TYPE_OPENLOOP
 696:Core/Src/main.c ****     return REF_MULT_OPENLOOP_MAX;
 697:Core/Src/main.c **** #else
 698:Core/Src/main.c ****     return MODULATION_INDEX;
 699:Core/Src/main.c **** #endif
 700:Core/Src/main.c **** }
 701:Core/Src/main.c **** 
 702:Core/Src/main.c **** /** Range-check happens here, on the way in -- the Execute_*_Control functions
 703:Core/Src/main.c ****  *  stay a pure hot path and just use whatever value is standing.
 704:Core/Src/main.c ****  *  @return the value actually applied, which is the request clamped to range. */
 705:Core/Src/main.c **** static float SetReferenceMultiplier(float value)
 706:Core/Src/main.c **** {
 707:Core/Src/main.c ****     const float limit = ReferenceMultiplierLimit();
 708:Core/Src/main.c **** 
 709:Core/Src/main.c ****     if (value < 0.0f)  { value = 0.0f; }
 710:Core/Src/main.c ****     if (value > limit) { value = limit; }
 711:Core/Src/main.c **** 
 712:Core/Src/main.c ****     reference_multiplier = value;
 713:Core/Src/main.c ****     return value;
