 701:Core/Src/main.c **** static uint8_t StreamChecksum(const AdcStreamFrame_t *f)
 702:Core/Src/main.c **** {
 703:Core/Src/main.c ****     const uint8_t *p = (const uint8_t*)&f->seq;
 704:Core/Src/main.c ****     const uint16_t len = (uint16_t)(sizeof(AdcStreamFrame_t) - sizeof(f->sync0)
 705:Core/Src/main.c ****                                      - sizeof(f->sync1) - sizeof(f->checksum));
 706:Core/Src/main.c ****     uint8_t sum = 0;
 707:Core/Src/main.c ****     for (uint16_t i = 0; i < len; i++) {
 708:Core/Src/main.c ****         sum += p[i];
 709:Core/Src/main.c ****     }
 710:Core/Src/main.c ****     return sum;
 711:Core/Src/main.c **** }
