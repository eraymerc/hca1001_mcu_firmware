 666:Core/Src/main.c **** static inline float Execute_HCA_Control(int16_t adc_signed, uint8_t update, float *ref_out)
 667:Core/Src/main.c **** {
 668:Core/Src/main.c ****     static uint32_t step_fundamental = (uint32_t)((50.0f / (2.0f*SWITCH_RATE)) * 4294967296.0f);
 669:Core/Src/main.c ****     static uint32_t angle_fundamental = 0;
 670:Core/Src/main.c **** 
 671:Core/Src/main.c ****     uint32_t theta = angle_fundamental;
 672:Core/Src/main.c ****     float r_t = HCA_fastSin(theta)*reference_multiplier;
 673:Core/Src/main.c **** 
 674:Core/Src/main.c ****     float error = r_t - (float)normaliseVoltage(adc_signed);
 675:Core/Src/main.c ****     float hca_out = HCA_Process(&hca, error);
 676:Core/Src/main.c **** 
 677:Core/Src/main.c ****     angle_fundamental += step_fundamental;
 678:Core/Src/main.c **** 
 679:Core/Src/main.c ****     if ((update & 0x1) == 0) {
 680:Core/Src/main.c **** #if IS_OPENLOOP
 681:Core/Src/main.c ****       USPWM(htim8.Instance, r_t, ARR_VAL, MODULATION_INDEX);  // modulation_index=1.0, already appl
 682:Core/Src/main.c **** #else
 683:Core/Src/main.c ****       USPWM(htim8.Instance, hca_out, ARR_VAL, MODULATION_INDEX);
 684:Core/Src/main.c **** #endif
 685:Core/Src/main.c ****     }
 686:Core/Src/main.c **** 
 687:Core/Src/main.c ****     *ref_out = r_t;
 688:Core/Src/main.c ****     return error;
 689:Core/Src/main.c **** }
