 258:Core/Src/main.c ****     /* DMA transmit is wired up (HAL_UART_TxCpltCallback below) but stays off
 259:Core/Src/main.c ****      * until the LPUART1 global interrupt is enabled in CubeMX: HAL signals a
 260:Core/Src/main.c ****      * DMA transmit's completion from the UART's TC interrupt, not the DMA's,
 261:Core/Src/main.c ****      * so without that NVIC entry gState never returns to READY and the stream
 262:Core/Src/main.c ****      * stops dead after one frame. Swap these two blocks once it is enabled.
 263:Core/Src/main.c ****      *
 264:Core/Src/main.c ****      *   if (!stream_tx_busy && (stream_fifo_tail != stream_fifo_head))
 265:Core/Src/main.c ****      *   {
 266:Core/Src/main.c ****      *     AdcStreamFrame_t *frame = &stream_fifo[stream_fifo_tail];
 267:Core/Src/main.c ****      *     if (HAL_UART_Transmit_DMA(&hlpuart1, (uint8_t*)frame,
 268:Core/Src/main.c ****      *                               (uint16_t)sizeof(AdcStreamFrame_t)) == HAL_OK)
 269:Core/Src/main.c ****      *     {
 270:Core/Src/main.c ****      *       stream_tx_busy = 1;
 271:Core/Src/main.c ****      *     }
 272:Core/Src/main.c ****      *   }
 273:Core/Src/main.c ****      */
 274:Core/Src/main.c ****     if (stream_fifo_tail != stream_fifo_head)
 275:Core/Src/main.c ****     {
 276:Core/Src/main.c ****       AdcStreamFrame_t *frame = &stream_fifo[stream_fifo_tail];
 277:Core/Src/main.c ****       if (HAL_UART_Transmit(&hlpuart1, (uint8_t*)frame,
 278:Core/Src/main.c ****                             (uint16_t)sizeof(AdcStreamFrame_t), 5) == HAL_OK)
 279:Core/Src/main.c ****       {
 280:Core/Src/main.c ****         stream_fifo_tail = (uint16_t)((stream_fifo_tail + 1U) & STREAM_FIFO_MASK);
 281:Core/Src/main.c ****       }
 282:Core/Src/main.c ****     }
 283:Core/Src/main.c ****   }
 284:Core/Src/main.c ****   /* USER CODE END 3 */
 285:Core/Src/main.c **** }
