 880:Core/Src/main.c **** /** Validate a fully received SET_REF payload and apply it. */
 881:Core/Src/main.c **** static void ApplyRefCommand(void)
 882:Core/Src/main.c **** {
 883:Core/Src/main.c ****     if (CoeffChecksum(coeff_rx, REF_CMD_PAYLOAD_LEN - 1U)
 884:Core/Src/main.c ****             != coeff_rx[REF_CMD_PAYLOAD_LEN - 1U]) {
 885:Core/Src/main.c ****         return; // corrupted on the wire; the host re-sends after its ack times out
 886:Core/Src/main.c ****     }
 887:Core/Src/main.c **** 
 888:Core/Src/main.c ****     float value;
 889:Core/Src/main.c ****     /* memcpy rather than a cast: coeff_rx is byte-aligned, see ApplyCoeffCommand. */
 890:Core/Src/main.c ****     memcpy(&value, &coeff_rx[0], sizeof(float));
 891:Core/Src/main.c **** 
 892:Core/Src/main.c ****     /* Rejects NaN too -- both comparisons in SetReferenceMultiplier are false
 893:Core/Src/main.c ****      * for it, so screen it out here rather than letting it reach the ISR. */
 894:Core/Src/main.c ****     if (value != value) {
 895:Core/Src/main.c ****         return;
 896:Core/Src/main.c ****     }
 897:Core/Src/main.c **** 
 898:Core/Src/main.c ****     SetReferenceMultiplier(value);
 899:Core/Src/main.c ****     SendRefFrame();  // echoes the clamped value, which is the host's ack
 900:Core/Src/main.c **** }
