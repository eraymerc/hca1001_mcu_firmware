 674:Core/Src/main.c **** static inline float adcToVoltsActual(int16_t adc_signed){
 675:Core/Src/main.c ****     float v_adc = (float)adc_signed * (ADC_VREF / ADC_FULL_SCALE_CODES); // differential volts at t
