1182:Core/Src/main.c ****          * zero -- in all three the gain would be a ratio of two noise floors. */
1183:Core/Src/main.c ****         SendCalFrame(CAL_STATUS_NO_SIGNAL, cal_vdc, raw_peak, raw_dc, expected_peak);
1184:Core/Src/main.c ****         return;
1185:Core/Src/main.c ****     }
1186:Core/Src/main.c **** 
