 583:Core/Src/main.c **** 
 584:Core/Src/main.c **** #define ADC_VREF              3.3f
 585:Core/Src/main.c **** #define ADC_FULL_SCALE_CODES  2048.0f  // ADC1 is differential; signed code -2048..2047 spans -VREF
 586:Core/Src/main.c **** #define V_PEAK_NOM            200.0f
 587:Core/Src/main.c **** 
 588:Core/Src/main.c **** /**
 589:Core/Src/main.c ****  * Sensor transfer function (measured/derived from the actual circuit):
 590:Core/Src/main.c ****  *   Vout_p = Vin * (250/22000) *  0.43 + 1.65V
 591:Core/Src/main.c ****  *   Vout_n = Vin * (250/22000) * -0.43 + 1.65V
 592:Core/Src/main.c ****  * Both differential pins are biased at 1.65V (VDDA/2) with the signal
 593:Core/Src/main.c ****  * riding symmetrically in opposite directions, so the differential the ADC
 594:Core/Src/main.c ****  * actually measures is:
 595:Core/Src/main.c ****  *   Vinp - Vinn = Vout_p - Vout_n = SENSOR_GAIN * Vin
 596:Core/Src/main.c ****  * where SENSOR_GAIN = 2 * (250/22000) * 0.43. The 1.65V bias on each pin
 597:Core/Src/main.c ****  * cancels out in the subtraction -- no bias removal needed in software.
 598:Core/Src/main.c ****  */
 599:Core/Src/main.c **** #define SENSOR_GAIN (2.0f * (250.0f / 44000.0f) * 0.4779f)
ARM GAS  /tmp/ccZNkETD.s 			page 12


 600:Core/Src/main.c **** /* Build-time calibration, used at boot and restored by STREAM_CMD_CAL_DEFAULT.
 601:Core/Src/main.c ****  * The live values live in dc_cal/gain_cal below and the host can re-derive
 602:Core/Src/main.c ****  * them at runtime; see RunCalibration. */
 603:Core/Src/main.c **** #define DC_CAL_DEFAULT   21.5f
 604:Core/Src/main.c **** #define GAIN_CAL_DEFAULT (172.0f/159.0f)
 605:Core/Src/main.c **** 
 606:Core/Src/main.c **** /** Live sensor correction: volts = raw*gain_cal + dc_cal. Written by the main
 607:Core/Src/main.c ****  *  loop when a calibration finishes, read by the 40kHz ISR every sample --
 608:Core/Src/main.c ****  *  volatile for the same reason as reference_multiplier. The two are written
 609:Core/Src/main.c ****  *  separately, so the ISR can see a new gain against an old offset for one
 610:Core/Src/main.c ****  *  sample; harmless here, both are only ever a few percent apart from their
 611:Core/Src/main.c ****  *  predecessors. */
 612:Core/Src/main.c **** static volatile float gain_cal = GAIN_CAL_DEFAULT;
 613:Core/Src/main.c **** static volatile float dc_cal   = DC_CAL_DEFAULT;
 614:Core/Src/main.c **** 
 615:Core/Src/main.c **** /**
 616:Core/Src/main.c ****  * ADC1 in differential mode reports Vinp-Vinn as a 12-bit *straight offset
 617:Core/Src/main.c ****  * binary* code (0..4095, unsigned) -- NOT two's complement. Code 2048
 618:Core/Src/main.c ****  * (0x800) means Vinp-Vinn = 0V; 0 means -VREF; 4095 means ~+VREF. Center
 619:Core/Src/main.c ****  * it on zero by subtracting the half-scale offset.
 620:Core/Src/main.c ****  */
 621:Core/Src/main.c **** static inline int16_t DifferentialCode(uint16_t raw12)
 622:Core/Src/main.c **** {
 623:Core/Src/main.c ****     return (int16_t)raw12 - (int16_t)ADC_FULL_SCALE_CODES;
 624:Core/Src/main.c **** }
 625:Core/Src/main.c **** 
 626:Core/Src/main.c **** /** Line volts as the sensor's nominal transfer function alone reports them,
 627:Core/Src/main.c ****  *  before any calibration correction. This is what the calibration measures --
 628:Core/Src/main.c ****  *  correcting a signal that already carries the old correction would fold it
 629:Core/Src/main.c ****  *  in twice. */
 630:Core/Src/main.c **** static inline float adcToVoltsRaw(int16_t adc_signed){
 631:Core/Src/main.c ****     float v_adc = (float)adc_signed * (ADC_VREF / ADC_FULL_SCALE_CODES); // differential volts at t
 632:Core/Src/main.c ****     return v_adc / SENSOR_GAIN;                                          // invert sensor formula -
 633:Core/Src/main.c **** }
 634:Core/Src/main.c **** 
 635:Core/Src/main.c **** static inline float adcToVoltsActual(int16_t adc_signed){
 636:Core/Src/main.c ****     return adcToVoltsRaw(adc_signed) * gain_cal + dc_cal;
 637:Core/Src/main.c **** }
 638:Core/Src/main.c **** 
 639:Core/Src/main.c **** static inline float normaliseVoltage(int16_t adc_signed){
 640:Core/Src/main.c ****     return adcToVoltsActual(adc_signed) / V_PEAK_NOM;       // normalize to ±1.0 like r_t
 641:Core/Src/main.c **** }
 642:Core/Src/main.c **** 
 643:Core/Src/main.c **** /**
 644:Core/Src/main.c ****  * @param adc_signed ADC1 differential reading, zero-centered (see DifferentialCode)
 645:Core/Src/main.c ****  */
 646:Core/Src/main.c **** /** Reference multiplier the device boots to, and ramps up to over
 647:Core/Src/main.c ****  *  REF_RAMP_MS. Must be inside ReferenceMultiplierLimit() for the loop mode
 648:Core/Src/main.c ****  *  this is built for; 0.85 is legal both open and closed loop. */
 649:Core/Src/main.c **** #define REF_MULT_BOOT 0.85f
 650:Core/Src/main.c **** 
 651:Core/Src/main.c **** /** Startup ramp: the reference is walked from zero to its target rather than
 652:Core/Src/main.c ****  *  applied as a step, so the bridge does not see full modulation depth on its
 653:Core/Src/main.c ****  *  first switching cycle while the controller's integrators are still empty.
 654:Core/Src/main.c ****  *  Also covers a later change from the host, which is a step of the same kind. */
 655:Core/Src/main.c **** #define REF_RAMP_MS      10.0f
 656:Core/Src/main.c **** #define REF_RAMP_SAMPLES ((float)((REF_RAMP_MS / 1000.0f) * (2.0f * SWITCH_RATE)))
ARM GAS  /tmp/ccZNkETD.s 			page 13


 657:Core/Src/main.c **** 
 658:Core/Src/main.c **** /** Where the reference is heading. Written by the main loop
 659:Core/Src/main.c ****  *  (SetReferenceMultiplier), read by the 40kHz ISR. */
 660:Core/Src/main.c **** static volatile float reference_target = REF_MULT_BOOT;
 661:Core/Src/main.c **** 
 662:Core/Src/main.c **** /** How far the ramp moves per ISR sample, sized so any change reaches its
 663:Core/Src/main.c ****  *  target in REF_RAMP_MS regardless of how far it has to travel. */
 664:Core/Src/main.c **** static volatile float reference_ramp_step = (REF_MULT_BOOT / REF_RAMP_SAMPLES);
