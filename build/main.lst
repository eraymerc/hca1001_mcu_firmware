  34:Core/Src/main.c **** /* USER CODE BEGIN PD */
  35:Core/Src/main.c **** #define ARR_VAL 8499
  36:Core/Src/main.c **** #define SWITCH_RATE 10000.0f  // Hz, TIM8 carrier frequency (170MHz / (2*(ARR_VAL+1)))
  37:Core/Src/main.c **** 
  38:Core/Src/main.c **** /* Center-aligned TIM8 raises an update event at both underflow and overflow
  39:Core/Src/main.c ****    (RepetitionCounter = 0), so the control ISR runs at twice the carrier rate. */
  40:Core/Src/main.c **** #define CONTROL_RATE  (2.0f * SWITCH_RATE)   // 20 kHz
  41:Core/Src/main.c **** #define CONTROL_DT    (1.0f / CONTROL_RATE)  // 50 us
  42:Core/Src/main.c **** 
  43:Core/Src/main.c **** /* ---------------------------------------------------------------------------
  44:Core/Src/main.c ****  * Open-loop V/f drive parameters -- ported from foc.hvr:
  45:Core/Src/main.c ****  *   module openloop  = open_loop<4, 95.5m, 0.5, 300.0>
  46:Core/Src/main.c ****  *   module generator = PWM_generator_3phase<2k, 310>
  47:Core/Src/main.c ****  *   module omegaGen  = reference_generator<>
  48:Core/Src/main.c ****  * ------------------------------------------------------------------------ */
  49:Core/Src/main.c **** #define POLE_PAIRS        4.0f    /**< p: mechanical -> electrical speed */
  50:Core/Src/main.c **** #define K_VF              0.0955f /**< V per electrical rad/s (= magnet flux) */
  51:Core/Src/main.c **** #define V_BOOST           0.5f    /**< phase amplitude floor near zero speed [V] */
  52:Core/Src/main.c **** #define V_MAX             300.0f  /**< phase peak voltage ceiling [V] */
  53:Core/Src/main.c **** 
  54:Core/Src/main.c **** /* reference_generator: mechanical speed ref, ramped from 0 over RAMP_TIME */
  55:Core/Src/main.c **** #define OMEGA_REF_FINAL   32.0f   /**< final mechanical speed reference [rad/s] */
  56:Core/Src/main.c **** #define OMEGA_REF_RAMP_S  10.0f    /**< ramp duration [s] */
  57:Core/Src/main.c **** 
  58:Core/Src/main.c **** /* PWM_generator_3phase */
  59:Core/Src/main.c **** #define VDC               310.0f  /**< DC bus voltage [V]; leg output is +-VDC/2 */
  60:Core/Src/main.c **** #define MODULATION_INDEX  1.0f    /**< SVPWM stays linear up to 2/sqrt(3) = 1.154 */
  61:Core/Src/main.c **** 
  62:Core/Src/main.c **** #define TWO_PI            6.2831853071795865f
  63:Core/Src/main.c **** #define SQRT3_OVER_2      0.8660254037844386f
  64:Core/Src/main.c **** /* USER CODE END PD */
  65:Core/Src/main.c **** 
