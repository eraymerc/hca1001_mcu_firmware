 887:Core/Src/main.c ****     memcpy(&kp.real, &coeff_rx[1],  sizeof(float));
 888:Core/Src/main.c ****     memcpy(&kp.imag, &coeff_rx[5],  sizeof(float));
 889:Core/Src/main.c ****     memcpy(&ki.real, &coeff_rx[9],  sizeof(float));
 890:Core/Src/main.c ****     memcpy(&ki.imag, &coeff_rx[13], sizeof(float));
 891:Core/Src/main.c **** 
 892:Core/Src/main.c ****     /* Gains only -- this never creates a channel. The set of active channels is
 893:Core/Src/main.c ****      * fixed at boot by the HCA_Add_Channel calls in main(), so the ISR's
 894:Core/Src/main.c ****      * per-sample workload cannot change underneath it while running.
 895:Core/Src/main.c ****      *
 896:Core/Src/main.c ****      * Safe from the main loop; see the thread-safety note on HCA_UpdateChannel.
 897:Core/Src/main.c ****      * An order with no channel is ignored there, and the absent echo below is
 898:Core/Src/main.c ****      * what tells the host the write did not land. */
 899:Core/Src/main.c ****     HCA_Handle_t *h = (HCA_Handle_t*)&hca;
 900:Core/Src/main.c ****     HCA_UpdateChannel(h, order, kp, ki);
 901:Core/Src/main.c **** 
 902:Core/Src/main.c ****     for (uint8_t i = 0; i < h->active_channel_count; i++) {
 903:Core/Src/main.c ****         if (h->channels[i].harmonic_order == order) {
 904:Core/Src/main.c ****             SendCoeffFrame(i, h->active_channel_count, &h->channels[i]);
 905:Core/Src/main.c ****             return;
