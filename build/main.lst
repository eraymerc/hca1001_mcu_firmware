 910:Core/Src/main.c **** /** Validate a fully received SET_REF payload and apply it. */
 911:Core/Src/main.c **** static void ApplyRefCommand(void)
 912:Core/Src/main.c **** {
 913:Core/Src/main.c ****     if (CoeffChecksum(coeff_rx, REF_CMD_PAYLOAD_LEN - 1U)
 914:Core/Src/main.c ****             != coeff_rx[REF_CMD_PAYLOAD_LEN - 1U]) {
 915:Core/Src/main.c ****         return; // corrupted on the wire; the host re-sends after its ack times out
 916:Core/Src/main.c ****     }
 917:Core/Src/main.c **** 
 918:Core/Src/main.c ****     float value;
 919:Core/Src/main.c ****     /* memcpy rather than a cast: coeff_rx is byte-aligned, see ApplyCoeffCommand. */
 920:Core/Src/main.c ****     memcpy(&value, &coeff_rx[0], sizeof(float));
 921:Core/Src/main.c **** 
 922:Core/Src/main.c ****     /* Rejects NaN too -- both comparisons in SetReferenceMultiplier are false
 923:Core/Src/main.c ****      * for it, so screen it out here rather than letting it reach the ISR. */
 924:Core/Src/main.c ****     if (value != value) {
 925:Core/Src/main.c ****         return;
