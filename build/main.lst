 709:Core/Src/main.c ****     if (next_head == stream_fifo_tail) {
 710:Core/Src/main.c ****         return; // consumer (UART) can't keep up, drop this batch
 711:Core/Src/main.c ****     }
 712:Core/Src/main.c **** 
 713:Core/Src/main.c ****     AdcStreamFrame_t *f = &stream_fifo[stream_fifo_head];
