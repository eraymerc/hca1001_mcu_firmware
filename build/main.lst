 583:Core/Src/main.c **** // Manages the HCA loop 40kHz sample rate and 1kHz telemetry rate
 584:Core/Src/main.c **** volatile uint32_t tick_counter = 0;
 585:Core/Src/main.c **** void HAL_ADC_ConvCpltCallback(ADC_HandleTypeDef *hadc)
 586:Core/Src/main.c **** {
 587:Core/Src/main.c ****     if (hadc->Instance == ADC1)
 588:Core/Src/main.c ****     {
 589:Core/Src/main.c ****         int16_t v_adc_signed = DifferentialCode(adc1_raw); // voltage, differential
 590:Core/Src/main.c **** 
 591:Core/Src/main.c ****         tick_counter++;
 592:Core/Src/main.c **** 
 593:Core/Src/main.c ****         float error = Execute_HCA_Control(v_adc_signed, tick_counter);
 594:Core/Src/main.c **** 
 595:Core/Src/main.c ****         if (streaming_enabled && ((tick_counter % ADC_STREAM_DECIMATION) == 0U))
 596:Core/Src/main.c ****         {
 597:Core/Src/main.c ****             float voltage_v = adcToVoltsActual(v_adc_signed);
 598:Core/Src/main.c ****             PushStreamFrame(voltage_v, error);
 599:Core/Src/main.c ****         }
 600:Core/Src/main.c ****     }
 601:Core/Src/main.c **** }
