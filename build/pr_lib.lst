 141:Core/Src/pr_lib.c ****         if (ch->harmonic_order == 0) {
 142:Core/Src/pr_lib.c ****             // ------------------------------------------------
 143:Core/Src/pr_lib.c ****             // DC integrator: y += Ts*Ki*e, clamped (anti-windup)
 144:Core/Src/pr_lib.c ****             // ------------------------------------------------
ARM GAS  /tmp/ccLfxqrg.s 			page 15


 145:Core/Src/pr_lib.c ****             float y = ch->y + ch->b0 * error;
 146:Core/Src/pr_lib.c ****             if (y >  limit) y =  limit;
