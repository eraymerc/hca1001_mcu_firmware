 686:Core/Src/main.c **** /** Round to the nearest count and saturate, so an out-of-range value pins at
 687:Core/Src/main.c ****  *  the rail instead of wrapping to the opposite sign. */
 688:Core/Src/main.c **** static inline int16_t ToStreamFixed(float value, float scale)
 689:Core/Src/main.c **** {
 690:Core/Src/main.c ****     float scaled = value * scale;
 691:Core/Src/main.c ****     if (scaled >=  32767.0f) { return  32767; }
 692:Core/Src/main.c ****     if (scaled <= -32768.0f) { return -32768; }
 693:Core/Src/main.c ****     return (int16_t)(scaled + ((scaled >= 0.0f) ? 0.5f : -0.5f));
 694:Core/Src/main.c **** }
