 796:Core/Src/main.c ****     /* Gains only -- this never creates a channel. The set of active channels is
 797:Core/Src/main.c ****      * fixed at boot by the HCA_Add_Channel calls in main(), so the ISR's
 798:Core/Src/main.c ****      * per-sample workload cannot change underneath it while running.
 799:Core/Src/main.c ****      *
 800:Core/Src/main.c ****      * Safe from the main loop; see the thread-safety note on HCA_UpdateChannel.
 801:Core/Src/main.c ****      * An order with no channel is ignored there, and the absent echo below is
 802:Core/Src/main.c ****      * what tells the host the write did not land. */
 803:Core/Src/main.c ****     HCA_Handle_t *h = (HCA_Handle_t*)&hca;
 804:Core/Src/main.c ****     HCA_UpdateChannel(h, order, kp, ki);
 805:Core/Src/main.c **** 
 806:Core/Src/main.c ****     for (uint8_t i = 0; i < h->active_channel_count; i++) {
 807:Core/Src/main.c ****         if (h->channels[i].harmonic_order == order) {
 808:Core/Src/main.c ****             SendCoeffFrame(i, h->active_channel_count, &h->channels[i]);
 809:Core/Src/main.c ****             return;
 810:Core/Src/main.c ****         }
 811:Core/Src/main.c ****     }
 812:Core/Src/main.c **** }
