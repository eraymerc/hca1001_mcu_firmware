 896:Core/Src/main.c **** /** Command byte polled from LPUART1 in the main loop (see HAL_UART_Receive call in USER CODE 3). *
 897:Core/Src/main.c **** static void HandleStreamCommand(uint8_t cmd)
 898:Core/Src/main.c **** {
 899:Core/Src/main.c ****     if (coeff_rx_active)
 900:Core/Src/main.c ****     {
 901:Core/Src/main.c ****         if ((HAL_GetTick() - coeff_rx_started_ms) > COEFF_CMD_TIMEOUT_MS) {
 902:Core/Src/main.c ****             coeff_rx_active = 0;  // stale payload; fall through and read this byte as a command
 903:Core/Src/main.c ****         } else {
 904:Core/Src/main.c ****             coeff_rx[coeff_rx_len++] = cmd;
 905:Core/Src/main.c ****             if (coeff_rx_len >= coeff_rx_expected) {
 906:Core/Src/main.c ****                 uint8_t pending = coeff_rx_active;
 907:Core/Src/main.c ****                 coeff_rx_active = 0;
 908:Core/Src/main.c ****                 coeff_rx_len = 0;
 909:Core/Src/main.c ****                 if (pending == STREAM_CMD_SET_COEFF) {
 910:Core/Src/main.c ****                     ApplyCoeffCommand();
 911:Core/Src/main.c ****                 } else {
 912:Core/Src/main.c ****                     ApplyRefCommand();
 913:Core/Src/main.c ****                 }
 914:Core/Src/main.c ****             }
 915:Core/Src/main.c ****             return;
 916:Core/Src/main.c ****         }
 917:Core/Src/main.c ****     }
 918:Core/Src/main.c **** 
 919:Core/Src/main.c ****     switch (cmd)
 920:Core/Src/main.c ****     {
 921:Core/Src/main.c ****         case STREAM_CMD_GET_COEFF:
 922:Core/Src/main.c ****             SendAllCoeffFrames();
 923:Core/Src/main.c ****             break;
 924:Core/Src/main.c **** 
 925:Core/Src/main.c ****         case STREAM_CMD_RESET_INT:
 926:Core/Src/main.c ****             /* Zeroes each channel's PI integrator and disperser accumulator and
 927:Core/Src/main.c ****              * clears the shared delay line. Runs from the main loop while the
 928:Core/Src/main.c ****              * ISR keeps calling HCA_Process, so the controller sees the state
 929:Core/Src/main.c ****              * vanish mid-sample -- that is the point of the command, but it does
 930:Core/Src/main.c ****              * put a transient on the output. The ~16KB memset costs roughly one
 931:Core/Src/main.c ****              * 40kHz ISR period.
 932:Core/Src/main.c ****              *
ARM GAS  /tmp/ccd6fuMZ.s 			page 25


 933:Core/Src/main.c ****              * Gains are untouched, so echoing them back doubles as the ack. */
 934:Core/Src/main.c ****             HCA_reset_accumulators((HCA_Handle_t*)&hca);
 935:Core/Src/main.c ****             SendAllCoeffFrames();
 936:Core/Src/main.c ****             break;
 937:Core/Src/main.c **** 
 938:Core/Src/main.c ****         case STREAM_CMD_SET_COEFF:
 939:Core/Src/main.c ****             coeff_rx_active = STREAM_CMD_SET_COEFF;
 940:Core/Src/main.c ****             coeff_rx_expected = COEFF_CMD_PAYLOAD_LEN;
 941:Core/Src/main.c ****             coeff_rx_len = 0;
 942:Core/Src/main.c ****             coeff_rx_started_ms = HAL_GetTick();
 943:Core/Src/main.c ****             break;
 944:Core/Src/main.c **** 
 945:Core/Src/main.c ****         case STREAM_CMD_SET_REF:
 946:Core/Src/main.c ****             coeff_rx_active = STREAM_CMD_SET_REF;
 947:Core/Src/main.c ****             coeff_rx_expected = REF_CMD_PAYLOAD_LEN;
 948:Core/Src/main.c ****             coeff_rx_len = 0;
 949:Core/Src/main.c ****             coeff_rx_started_ms = HAL_GetTick();
 950:Core/Src/main.c ****             break;
 951:Core/Src/main.c **** 
 952:Core/Src/main.c ****         case STREAM_CMD_GET_REF:
