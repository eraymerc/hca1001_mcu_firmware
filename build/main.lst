 231:Core/Src/main.c ****     }
 232:Core/Src/main.c **** 
 233:Core/Src/main.c ****     /* DMA transmit is wired up (HAL_UART_TxCpltCallback below) but stays off
 234:Core/Src/main.c ****      * until the LPUART1 global interrupt is enabled in CubeMX: HAL signals a
 235:Core/Src/main.c ****      * DMA transmit's completion from the UART's TC interrupt, not the DMA's,
 236:Core/Src/main.c ****      * so without that NVIC entry gState never returns to READY and the stream
 237:Core/Src/main.c ****      * stops dead after one frame. Swap these two blocks once it is enabled.
 238:Core/Src/main.c ****      *
 239:Core/Src/main.c ****      *   if (!stream_tx_busy && (stream_fifo_tail != stream_fifo_head))
 240:Core/Src/main.c ****      *   {
 241:Core/Src/main.c ****      *     AdcStreamFrame_t *frame = &stream_fifo[stream_fifo_tail];
 242:Core/Src/main.c ****      *     if (HAL_UART_Transmit_DMA(&hlpuart1, (uint8_t*)frame,
 243:Core/Src/main.c ****      *                               (uint16_t)sizeof(AdcStreamFrame_t)) == HAL_OK)
 244:Core/Src/main.c ****      *     {
 245:Core/Src/main.c ****      *       stream_tx_busy = 1;
 246:Core/Src/main.c ****      *     }
 247:Core/Src/main.c ****      *   }
 248:Core/Src/main.c ****      */
 249:Core/Src/main.c ****     if (stream_fifo_tail != stream_fifo_head)
 250:Core/Src/main.c ****     {
 251:Core/Src/main.c ****       AdcStreamFrame_t *frame = &stream_fifo[stream_fifo_tail];
 252:Core/Src/main.c ****       if (HAL_UART_Transmit(&hlpuart1, (uint8_t*)frame,
 253:Core/Src/main.c ****                             (uint16_t)sizeof(AdcStreamFrame_t), 5) == HAL_OK)
 254:Core/Src/main.c ****       {
 255:Core/Src/main.c ****         stream_fifo_tail = (uint16_t)((stream_fifo_tail + 1U) & STREAM_FIFO_MASK);
 256:Core/Src/main.c ****       }
 257:Core/Src/main.c ****     }
