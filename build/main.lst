 972:Core/Src/main.c ****             break;
 973:Core/Src/main.c **** 
 974:Core/Src/main.c ****         case STREAM_CMD_SET_COEFF:
 975:Core/Src/main.c ****             coeff_rx_active = STREAM_CMD_SET_COEFF;
 976:Core/Src/main.c ****             coeff_rx_expected = COEFF_CMD_PAYLOAD_LEN;
 977:Core/Src/main.c ****             coeff_rx_len = 0;
 978:Core/Src/main.c ****             coeff_rx_started_ms = HAL_GetTick();
 979:Core/Src/main.c ****             break;
 980:Core/Src/main.c **** 
 981:Core/Src/main.c ****         case STREAM_CMD_SET_REF:
