 107:Core/Src/main.c **** 
 108:Core/Src/main.c **** /* Single-producer (ADC ISR) / single-consumer (main loop) ring buffer of frames */
 109:Core/Src/main.c **** static AdcStreamFrame_t  stream_fifo[STREAM_FIFO_LEN];
 110:Core/Src/main.c **** static volatile uint16_t stream_fifo_head = 0;
 111:Core/Src/main.c **** static volatile uint16_t stream_fifo_tail = 0;
