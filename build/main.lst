 594:Core/Src/main.c **** #define ADC_VREF              3.3f
 595:Core/Src/main.c **** #define ADC_FULL_SCALE_CODES  2048.0f  // ADC1 is differential; signed code -2048..2047 spans -VREF
 596:Core/Src/main.c **** #define V_PEAK_NOM            200.0f
 597:Core/Src/main.c **** 
 598:Core/Src/main.c **** /**
 599:Core/Src/main.c ****  * Sensor transfer function (measured/derived from the actual circuit):
ARM GAS  /tmp/ccf1vJ6l.s 			page 12


 600:Core/Src/main.c ****  *   Vout_p = Vin * (250/22000) *  0.43 + 1.65V
 601:Core/Src/main.c ****  *   Vout_n = Vin * (250/22000) * -0.43 + 1.65V
 602:Core/Src/main.c ****  * Both differential pins are biased at 1.65V (VDDA/2) with the signal
 603:Core/Src/main.c ****  * riding symmetrically in opposite directions, so the differential the ADC
 604:Core/Src/main.c ****  * actually measures is:
 605:Core/Src/main.c ****  *   Vinp - Vinn = Vout_p - Vout_n = SENSOR_GAIN * Vin
 606:Core/Src/main.c ****  * where SENSOR_GAIN = 2 * (250/22000) * 0.43. The 1.65V bias on each pin
 607:Core/Src/main.c ****  * cancels out in the subtraction -- no bias removal needed in software.
 608:Core/Src/main.c ****  */
 609:Core/Src/main.c **** #define SENSOR_GAIN (2.0f * (250.0f / 44000.0f) * 0.4779f)
 610:Core/Src/main.c **** #define DC_CAL 2.6f
 611:Core/Src/main.c **** #define GAIN_CAL 1.0f
 612:Core/Src/main.c **** 
 613:Core/Src/main.c **** /**
 614:Core/Src/main.c ****  * ADC1 in differential mode reports Vinp-Vinn as a 12-bit *straight offset
 615:Core/Src/main.c ****  * binary* code (0..4095, unsigned) -- NOT two's complement. Code 2048
 616:Core/Src/main.c ****  * (0x800) means Vinp-Vinn = 0V; 0 means -VREF; 4095 means ~+VREF. Center
 617:Core/Src/main.c ****  * it on zero by subtracting the half-scale offset.
 618:Core/Src/main.c ****  */
 619:Core/Src/main.c **** static inline int16_t DifferentialCode(uint16_t raw12)
 620:Core/Src/main.c **** {
 621:Core/Src/main.c ****     return (int16_t)raw12 - (int16_t)ADC_FULL_SCALE_CODES;
 622:Core/Src/main.c **** }
 623:Core/Src/main.c **** 
 624:Core/Src/main.c **** static inline float adcToVoltsActual(int16_t adc_signed){
 625:Core/Src/main.c ****     float v_adc = (float)adc_signed * (ADC_VREF / ADC_FULL_SCALE_CODES); // differential volts at t
 626:Core/Src/main.c ****     return (v_adc / SENSOR_GAIN)*GAIN_CAL + DC_CAL;                                          // inv
 627:Core/Src/main.c **** }
 628:Core/Src/main.c **** 
 629:Core/Src/main.c **** static inline float normaliseVoltage(int16_t adc_signed){
 630:Core/Src/main.c ****     return adcToVoltsActual(adc_signed) / V_PEAK_NOM;       // normalize to ±1.0 like r_t
 631:Core/Src/main.c **** }
 632:Core/Src/main.c **** 
 633:Core/Src/main.c **** /**
 634:Core/Src/main.c ****  * @param adc_signed ADC1 differential reading, zero-centered (see DifferentialCode)
 635:Core/Src/main.c ****  */
 636:Core/Src/main.c **** /** Scales the sine reference before it reaches the modulator. Written from the
 637:Core/Src/main.c ****  *  main loop (SetReferenceMultiplier), read by the 40kHz ISR -- volatile so the
 638:Core/Src/main.c ****  *  ISR cannot cache a stale copy. A 32-bit aligned float is written atomically
 639:Core/Src/main.c ****  *  on Cortex-M4, so the ISR never sees a half-updated value. */
 640:Core/Src/main.c **** static volatile float reference_multiplier = 0.85f;
 641:Core/Src/main.c **** 
 642:Core/Src/main.c **** /** Largest reference multiplier this build accepts, see IS_OPENLOOP above. */
 643:Core/Src/main.c **** static inline float ReferenceMultiplierLimit(void)
 644:Core/Src/main.c **** {
 645:Core/Src/main.c **** #if IS_OPENLOOP
 646:Core/Src/main.c ****     return REF_MULT_OPENLOOP_MAX;
 647:Core/Src/main.c **** #else
 648:Core/Src/main.c ****     return MODULATION_INDEX;
 649:Core/Src/main.c **** #endif
 650:Core/Src/main.c **** }
 651:Core/Src/main.c **** 
 652:Core/Src/main.c **** /** Range-check happens here, on the way in -- Execute_HCA_Control stays a pure
 653:Core/Src/main.c ****  *  hot path and just uses whatever value is standing.
 654:Core/Src/main.c ****  *  @return the value actually applied, which is the request clamped to range. */
 655:Core/Src/main.c **** static float SetReferenceMultiplier(float value)
 656:Core/Src/main.c **** {
ARM GAS  /tmp/ccf1vJ6l.s 			page 13


 657:Core/Src/main.c ****     const float limit = ReferenceMultiplierLimit();
 658:Core/Src/main.c **** 
 659:Core/Src/main.c ****     if (value < 0.0f)  { value = 0.0f; }
