 898:Core/Src/main.c **** /* Batch under construction. Only the ISR touches it, so it needs no guarding. */
 899:Core/Src/main.c **** static AdcStreamFrame_t stream_accum;
 900:Core/Src/main.c **** static uint8_t          stream_accum_count = 0;
 901:Core/Src/main.c **** 
 902:Core/Src/main.c **** /**
 903:Core/Src/main.c ****  * Producer side (called from ADC ISR). Accumulates STREAM_BATCH_SAMPLES samples
 904:Core/Src/main.c ****  * and pushes them as one frame; drops the whole batch if the FIFO is full.
 905:Core/Src/main.c ****  *
 906:Core/Src/main.c ****  * seq is advanced only on a successful push, which is what lets the host tell
 907:Core/Src/main.c ****  * the two loss modes apart: a FIFO overflow here leaves seq contiguous but
 908:Core/Src/main.c ****  * slower than wall-clock, while bytes lost on the wire leave holes in seq.
 909:Core/Src/main.c ****  */
 910:Core/Src/main.c **** static inline void PushStreamFrame(float voltage, float error)
 911:Core/Src/main.c **** {
 912:Core/Src/main.c ****     if (stream_accum_count == 0U) {
 913:Core/Src/main.c ****         stream_accum.timestamp_ms = HAL_GetTick();
 914:Core/Src/main.c ****     }
 915:Core/Src/main.c **** 
 916:Core/Src/main.c ****     stream_accum.samples[stream_accum_count].voltage = voltage;
 917:Core/Src/main.c ****     stream_accum.samples[stream_accum_count].error   = error;
 918:Core/Src/main.c **** 
 919:Core/Src/main.c ****     if (++stream_accum_count < STREAM_BATCH_SAMPLES) {
 920:Core/Src/main.c ****         return; // batch still filling
 921:Core/Src/main.c ****     }
 922:Core/Src/main.c ****     stream_accum_count = 0;
 923:Core/Src/main.c **** 
 924:Core/Src/main.c ****     uint16_t next_head = (uint16_t)((stream_fifo_head + 1U) & STREAM_FIFO_MASK);
 925:Core/Src/main.c ****     if (next_head == stream_fifo_tail) {
 926:Core/Src/main.c ****         return; // consumer (UART) can't keep up, drop this batch
 927:Core/Src/main.c ****     }
 928:Core/Src/main.c **** 
 929:Core/Src/main.c ****     AdcStreamFrame_t *f = &stream_fifo[stream_fifo_head];
 930:Core/Src/main.c ****     *f              = stream_accum;
 931:Core/Src/main.c ****     f->sync0        = STREAM_SYNC0;
 932:Core/Src/main.c ****     f->sync1        = STREAM_SYNC1;
 933:Core/Src/main.c ****     f->seq          = stream_seq++;
 934:Core/Src/main.c ****     f->checksum     = StreamChecksum(f);
 935:Core/Src/main.c **** 
 936:Core/Src/main.c ****     stream_fifo_head = next_head;
 937:Core/Src/main.c **** }
