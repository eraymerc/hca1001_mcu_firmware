 983:Core/Src/main.c ****      * faults on an unaligned float load. */
 984:Core/Src/main.c ****     memcpy(&kp.real, &coeff_rx[1],  sizeof(float));
 985:Core/Src/main.c ****     memcpy(&kp.imag, &coeff_rx[5],  sizeof(float));
 986:Core/Src/main.c ****     memcpy(&ki.real, &coeff_rx[9],  sizeof(float));
 987:Core/Src/main.c ****     memcpy(&ki.imag, &coeff_rx[13], sizeof(float));
 988:Core/Src/main.c **** 
 989:Core/Src/main.c ****     /* Gains only -- this never creates a channel. The set of active channels is
 990:Core/Src/main.c ****      * fixed at boot by the HCA_Add_Channel calls in main(), so the ISR's
ARM GAS  /tmp/ccrYxNU5.s 			page 23


 991:Core/Src/main.c ****      * per-sample workload cannot change underneath it while running.
 992:Core/Src/main.c ****      *
 993:Core/Src/main.c ****      * Safe from the main loop; see the thread-safety note on HCA_UpdateChannel.
 994:Core/Src/main.c ****      * An order with no channel is ignored there, and the absent echo below is
 995:Core/Src/main.c ****      * what tells the host the write did not land. */
 996:Core/Src/main.c ****     HCA_Handle_t *h = (HCA_Handle_t*)&hca;
 997:Core/Src/main.c ****     HCA_UpdateChannel(h, order, kp, ki);
 998:Core/Src/main.c **** 
 999:Core/Src/main.c ****     for (uint8_t i = 0; i < h->active_channel_count; i++) {
1000:Core/Src/main.c ****         if (h->channels[i].harmonic_order == order) {
1001:Core/Src/main.c ****             SendCoeffFrame(i, h->active_channel_count, &h->channels[i]);
1002:Core/Src/main.c ****             return;
1003:Core/Src/main.c ****         }
1004:Core/Src/main.c ****     }
1005:Core/Src/main.c **** }
