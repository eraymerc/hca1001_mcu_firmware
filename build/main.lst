 787:Core/Src/main.c **** /**
 788:Core/Src/main.c ****  * Command replies still transmit in blocking mode -- they are rare and
 789:Core/Src/main.c ****  * user-triggered. HAL refuses a transmit while gState is BUSY_TX, so wait out
 790:Core/Src/main.c ****  * any stream frame first rather than letting the reply be dropped. Bounded by
 791:Core/Src/main.c ****  * one frame time, ~360us at 2,097,000 baud.
 792:Core/Src/main.c ****  */
 793:Core/Src/main.c **** static void StreamTxWaitIdle(void)
 794:Core/Src/main.c **** {
 795:Core/Src/main.c ****     while (stream_tx_busy)
 796:Core/Src/main.c ****     {
 797:Core/Src/main.c ****         /* the DMA1_Channel3 IRQ clears this */
 798:Core/Src/main.c ****     }
 799:Core/Src/main.c **** }
