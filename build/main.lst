 938:Core/Src/main.c ****             coeff_rx_active = 0;  // stale payload; fall through and read this byte as a command
 939:Core/Src/main.c ****         } else {
 940:Core/Src/main.c ****             coeff_rx[coeff_rx_len++] = cmd;
 941:Core/Src/main.c ****             if (coeff_rx_len >= coeff_rx_expected) {
 942:Core/Src/main.c ****                 uint8_t pending = coeff_rx_active;
 943:Core/Src/main.c ****                 coeff_rx_active = 0;
 944:Core/Src/main.c ****                 coeff_rx_len = 0;
 945:Core/Src/main.c ****                 if (pending == STREAM_CMD_SET_COEFF) {
 946:Core/Src/main.c ****                     ApplyCoeffCommand();
 947:Core/Src/main.c ****                 } else {
 948:Core/Src/main.c ****                     ApplyRefCommand();
 949:Core/Src/main.c ****                 }
 950:Core/Src/main.c ****             }
