 902:Core/Src/main.c **** /** Command byte polled from LPUART1 in the main loop (see HAL_UART_Receive call in USER CODE 3). *
 903:Core/Src/main.c **** static void HandleStreamCommand(uint8_t cmd)
 904:Core/Src/main.c **** {
 905:Core/Src/main.c ****     if (coeff_rx_active)
 906:Core/Src/main.c ****     {
 907:Core/Src/main.c ****         if ((HAL_GetTick() - coeff_rx_started_ms) > COEFF_CMD_TIMEOUT_MS) {
 908:Core/Src/main.c ****             coeff_rx_active = 0;  // stale payload; fall through and read this byte as a command
 909:Core/Src/main.c ****         } else {
 910:Core/Src/main.c ****             coeff_rx[coeff_rx_len++] = cmd;
 911:Core/Src/main.c ****             if (coeff_rx_len >= coeff_rx_expected) {
 912:Core/Src/main.c ****                 uint8_t pending = coeff_rx_active;
 913:Core/Src/main.c ****                 coeff_rx_active = 0;
 914:Core/Src/main.c ****                 coeff_rx_len = 0;
 915:Core/Src/main.c ****                 if (pending == STREAM_CMD_SET_COEFF) {
 916:Core/Src/main.c ****                     ApplyCoeffCommand();
 917:Core/Src/main.c ****                 } else {
 918:Core/Src/main.c ****                     ApplyRefCommand();
 919:Core/Src/main.c ****                 }
 920:Core/Src/main.c ****             }
 921:Core/Src/main.c ****             return;
 922:Core/Src/main.c ****         }
 923:Core/Src/main.c ****     }
 924:Core/Src/main.c **** 
 925:Core/Src/main.c ****     switch (cmd)
 926:Core/Src/main.c ****     {
 927:Core/Src/main.c ****         case STREAM_CMD_GET_COEFF:
 928:Core/Src/main.c ****             SendAllCoeffFrames();
 929:Core/Src/main.c ****             break;
 930:Core/Src/main.c **** 
 931:Core/Src/main.c ****         case STREAM_CMD_RESET_INT:
