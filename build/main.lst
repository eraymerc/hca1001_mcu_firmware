 563:Core/Src/main.c **** /** Producer side (called from ADC ISR). Drops the sample if the FIFO is full. */
 564:Core/Src/main.c **** static inline void PushStreamFrame(float voltage, float error)
 565:Core/Src/main.c **** {
 566:Core/Src/main.c ****     uint16_t next_head = (uint16_t)((stream_fifo_head + 1U) & STREAM_FIFO_MASK);
 567:Core/Src/main.c ****     if (next_head == stream_fifo_tail) {
 568:Core/Src/main.c ****         return; // consumer (UART) can't keep up, drop this sample
 569:Core/Src/main.c ****     }
 570:Core/Src/main.c **** 
 571:Core/Src/main.c ****     AdcStreamFrame_t *f = &stream_fifo[stream_fifo_head];
 572:Core/Src/main.c ****     f->sync0        = STREAM_SYNC0;
 573:Core/Src/main.c ****     f->sync1        = STREAM_SYNC1;
 574:Core/Src/main.c ****     f->seq          = stream_seq++;
 575:Core/Src/main.c ****     f->timestamp_ms = HAL_GetTick();
