 700:Core/Src/main.c ****     stream_accum.samples[stream_accum_count].voltage = voltage;
 701:Core/Src/main.c ****     stream_accum.samples[stream_accum_count].error   = error;
 702:Core/Src/main.c **** 
 703:Core/Src/main.c ****     if (++stream_accum_count < STREAM_BATCH_SAMPLES) {
 704:Core/Src/main.c ****         return; // batch still filling
 705:Core/Src/main.c ****     }
 706:Core/Src/main.c ****     stream_accum_count = 0;
 707:Core/Src/main.c **** 
