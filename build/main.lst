 962:Core/Src/main.c ****             break;
 963:Core/Src/main.c **** 
 964:Core/Src/main.c ****         case STREAM_CMD_PING:
 965:Core/Src/main.c ****             StreamTxWaitIdle();
 966:Core/Src/main.c ****             HAL_UART_Transmit(&hlpuart1, (uint8_t*)STREAM_PING_REPLY,
 967:Core/Src/main.c ****                                (uint16_t)(sizeof(STREAM_PING_REPLY) - 1U), 10);
 968:Core/Src/main.c ****             break;
 969:Core/Src/main.c **** 
