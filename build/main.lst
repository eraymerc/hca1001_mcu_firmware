 223:Core/Src/main.c ****     /* Everything DMA has written since the last pass. CNDTR counts down, so
 224:Core/Src/main.c ****      * the write position is the buffer length minus what is left to fill. */
 225:Core/Src/main.c ****     uint16_t rx_head = (uint16_t)(UART_RX_DMA_LEN
 226:Core/Src/main.c ****                                   - __HAL_DMA_GET_COUNTER(&hdma_lpuart1_rx));
