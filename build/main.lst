 963:Core/Src/main.c **** static void SendAllCoeffFrames(void)
 964:Core/Src/main.c **** {
 965:Core/Src/main.c ****     HCA_Handle_t *h = (HCA_Handle_t*)&hca;
 966:Core/Src/main.c ****     uint8_t count = h->active_channel_count;
