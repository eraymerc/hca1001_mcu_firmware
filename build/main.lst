 943:Core/Src/main.c **** 
 944:Core/Src/main.c ****         case STREAM_CMD_SET_COEFF:
 945:Core/Src/main.c ****             coeff_rx_active = STREAM_CMD_SET_COEFF;
 946:Core/Src/main.c ****             coeff_rx_expected = COEFF_CMD_PAYLOAD_LEN;
 947:Core/Src/main.c ****             coeff_rx_len = 0;
 948:Core/Src/main.c ****             coeff_rx_started_ms = HAL_GetTick();
 949:Core/Src/main.c ****             break;
 950:Core/Src/main.c **** 
